<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Studio.IdeTests</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Runner is referenced only for build ordering (no assembly reference). -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common\Common.csproj" />
    <ProjectReference Include="..\..\src\Simula\Simula.csproj" />
    <ProjectReference Include="..\..\src\Algol68\Algol68.csproj" />
    <ProjectReference Include="..\..\src\Algol60\Algol60.csproj" />
    <ProjectReference Include="..\..\src\SimulaI\SimulaI.csproj" />
    <!-- Built for the end-to-end tests (standalone exe, CLI), without assembly reference. -->
    <ProjectReference Include="..\..\src\Runner\Runner.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\SimC\SimC.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\A68C\A68C.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\A60C\A60C.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\S1C\S1C.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Runner\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Ide\Language\*.cs" Link="Language\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
