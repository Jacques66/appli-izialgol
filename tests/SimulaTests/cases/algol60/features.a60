begin
   comment input, dynamic arrays, value arrays, label parameters, procedure parameters,
           fat commas, own arrays, conditional expressions, nested blocks;
   integer n, i, k;
   real r;

   procedure readall(n); integer n;
   begin integer j, v, s;
      s := 0;
      for j := 1 step 1 until n do begin ininteger(0, v); s := s + v end;
      outstring(1, "sum read = "); outinteger(1, s); outstring(1, "\n")
   end;

   real procedure total(v, n); value v; real array v; integer n;
   begin integer j; real t;
      t := 0;
      for j := 1 step 1 until n do begin t := t + v[j]; v[j] := 0 end;
      total := t
   end;

   procedure check(x, bad); value x; real x; label bad;
      if x < 0 then go to bad;

   real procedure apply(f, x); real procedure f; real x; apply := f(x);
   real procedure half(x); value x; real x; half := x / 2;

   procedure tally(c) Times: (t); integer c, t;
   begin own integer array hits[1:3];
      hits[c] := hits[c] + t;
      outinteger(1, hits[1]); outinteger(1, hits[2]); outinteger(1, hits[3]); outstring(1, "\n")
   end;

   ininteger(0, n);
   readall(n);
   inreal(0, r);
   outstring(1, "real read = "); outreal(1, r); outstring(1, "\n");
   begin
      real array data[1:n + 1];
      for i := 1 step 1 until n + 1 do data[i] := i * 1.5;
      outstring(1, "total = "); outreal(1, total(data, n + 1));
      outstring(1, "data[2] still = "); outreal(1, data[2]); outstring(1, "\n")
   end;
   check(1.0, neg);
   check(-1.0, neg);
   outstring(1, "not reached\n");
neg:
   outstring(1, "jumped to neg\n");
   outreal(1, apply(half, 9)); outreal(1, apply(sqrt, 2)); outstring(1, "\n");
   tally(1, 5); tally(3) Times: (2); tally(1, 1);
   k := if n > 2 then 10 else 20;
   outinteger(1, k);
   for i := 1, 2, 4 step 4 until 12, 100 do outinteger(1, i);
   outstring(1, "\n");
   for i := 1, i * 3 while i < 100 do outinteger(1, i);
   outstring(1, "\n");
   outinteger(1, maxint); outreal(1, epsilon); outstring(1, "\n")
end
