comment Algol 60 basics: blocks, procedures, call by name, own variables, switches;
begin
   integer i, n;
   real x;
   integer array a[1:10];
   Boolean b;

   integer procedure fact(n); value n; integer n;
      fact := if n <= 1 then 1 else n * fact(n - 1);

   real procedure sum(i, lo, hi, term); value lo, hi; integer i, lo, hi; real term;
   begin real s;
      s := 0;
      for i := lo step 1 until hi do s := s + term;
      sum := s
   end sum;

   procedure counter;
   begin own integer count;
      count := count + 1;
      outstring(1, "call number "); outinteger(1, count); outstring(1, "\n")
   end;

   procedure swap(p, q); integer p, q;
   begin integer t; t := p; p := q; q := t end;

   switch s := l1, l2, l3;

   outstring(1, "10! = "); outinteger(1, fact(10)); outstring(1, "\n");
   for i := 1 step 1 until 10 do a[i] := i * i;
   outstring(1, "sum of squares = "); outreal(1, sum(i, 1, 10, a[i])); outstring(1, "\n");
   outstring(1, "harmonic(4) = "); outreal(1, sum(i, 1, 4, 1 / i)); outstring(1, "\n");
   counter; counter; counter;
   i := 3; n := 7; swap(i, n);
   outinteger(1, i); outinteger(1, n); outstring(1, "\n");
   n := 2;
   go to s[n];
l1: outstring(1, "never\n");
l2: outstring(1, "reached l2\n");
l3:
   b := 3 > 2 ∧ ¬ (1 = 2);
   if b then outstring(1, "logic ok\n");
   x := 2 ↑ 10; outreal(1, x); outstring(1, "\n");
   outinteger(1, 17 ÷ 5); outinteger(1, -17 ÷ 5); outinteger(1, entier(-1.5)); outinteger(1, iabs(-4)); outstring(1, "\n");
   outreal(1, 1.5⏨3); outreal(1, 0.001); outreal(1, 1/3); outreal(1, -2.5); outstring(1, "\n");
   outinteger(1, length("abc")); outchar(1, "xyz", 2); outstring(1, `inner `NL' newline'); outstring(1, "\n")
end
