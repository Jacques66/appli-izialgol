'BEGIN' 'COMMENT' Knuth's man or boy test, in its original Algol 60 form,
   written with quote stropping (spaces inside identifiers are ignored);
   'REAL' 'PROCEDURE' A (k, x1, x2, x3, x4, x5);
      'VALUE' k; 'INTEGER' k; 'REAL' x1, x2, x3, x4, x5;
   'BEGIN'
      'REAL' 'PROCEDURE' B;
      'BEGIN' k := k - 1;
         B := A := A (k, B, x1, x2, x3, x4)
      'END';
      'IF' k 'LE' 0 'THEN' A := x4 + x5 'ELSE' B
   'END';
   'INTEGER' k;
   'FOR' k := 0 'STEP' 1 'UNTIL' 11 'DO'
   'BEGIN'
      out string (1, `k = '); out integer (1, k);
      out string (1, `result '); out real (1, A (k, 1, -1, -1, 1, 0));
      out string (1, `
')
   'END'
'END'
