begin
   ! symmetric coroutines: two ping-pong players ;
   class player(pname, n); text pname; integer n;
   begin ref(player) other; integer i;
      detach;
      for i := 1 step 1 until n do
      begin
         outtext(pname); outint(i, 2); outimage;
         resume(other)
      end
   end;

   ! semi-symmetric: generator called by call ;
   class generator;
   begin integer val;
      val := 1; detach;
      while true do begin val := val * 2; detach end
   end;

   ref(player) a, b; ref(generator) g; integer k;

   begin
      a :- new player("ping", 3);
      b :- new player("pong", 3);
      a.other :- b; b.other :- a;
      resume(a);
      outtext("back in the main program"); outimage
   end;

   g :- new generator;
   for k := 1 step 1 until 5 do begin outint(g.val, 4); call(g) end;
   outimage;

   ! example of the standard (7.4) ;
   begin
      ref(C1) X1; ref(C2) X2;
      class C1; begin procedure P1; begin outtext("C1 detach"); outimage; detach; outtext("C1 resumed"); outimage end; P1 end;
      class C2;
      begin
         procedure P2; begin outtext("P2 detach"); outimage; detach; outtext("P2 resumed"); outimage end;
         begin ref(C3) X3;
            class C3; begin outtext("C3 detach"); outimage; detach; P2; outtext("end C3"); outimage end;
            X3 :- new C3;
            resume(X3);
            outtext("end S2"); outimage
         end
      end C2;
      X1 :- new C1;
      X2 :- new C2;
      outtext("before call(X2)"); outimage;
      call(X2);
      outtext("after call(X2)"); outimage;
      call(X1);
      outtext("end S1"); outimage
   end
end
