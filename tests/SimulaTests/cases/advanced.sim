begin
   ! virtuals whose matches have different headings: generic call ;
   class shape; virtual: procedure draw; begin end;
   shape class square_c; begin procedure draw(n); integer n; begin outtext("square "); outint(n, 0) end; end;
   shape class round_c; begin procedure draw(t); text t; begin outtext("round "); outtext(t) end; end;

   ! class with parameters used as a block prefix ;
   class counter(start); integer start;
   virtual: procedure trace;
   begin integer n;
      procedure tick; begin n := n + 1; trace end;
      procedure trace; ;
      n := start;
      inner;
      outtext("final counter = "); outint(n, 0); outimage
   end;

   ! prefix chain with inner in the middle ;
   class a; begin outtext("a1 "); inner; outtext("a2 ") end;
   a class b; begin outtext("b1 "); inner; outtext("b2 ") end;
   b class c; begin outtext("c ") end;

   ! virtual label ;
   class machine; virtual: label halt;
   begin integer stage;
      stage := 1;
      goto halt;
      outtext("never");
   end;
   machine class machine2;
   begin
halt: outtext("stop reached at stage "); outint(stage, 0); outimage
   end;

   ! protection ;
   class account; protected balance; hidden protected secret;
   begin integer balance, secret;
      procedure deposit(x); integer x; balance := balance + x;
      integer procedure read_balance; read_balance := balance;
   end;
   account class savings_account;
   begin procedure interest; balance := balance + balance // 10; end;

   ! formal procedure parameter with its own parameters ;
   real procedure integrate(f, a, b, n); real procedure f; real a, b; integer n;
   begin real h, s; integer i;
      h := (b - a) / n;
      for i := 0 step 1 until n - 1 do s := s + f(a + (i + 0.5) * h);
      integrate := s * h
   end;
   real procedure cube(x); real x; cube := x * x * x;

   ! Jensen's inner product with arrays ;
   real procedure inner_product(a, b, k, n); name a, b, k; real a, b; integer k, n;
   begin real s; k := 1; while k <= n do begin s := s + a * b; k := k + 1 end; inner_product := s end;

   ref(shape) f1, f2; ref(savings_account) acct; integer i; real array u, w(1:3);

   f1 :- new square_c; f2 :- new round_c;
   f1.draw(4); outtext(" / "); f2.draw("bleu"); outimage;

   counter(10) begin
      procedure trace; begin outtext("tick "); outint(n, 0); outimage end;
      tick; tick
   end;

   new c; outimage;
   new b; outimage;

   new machine2;

   acct :- new savings_account;
   acct.deposit(100); acct.interest; outint(acct.read_balance, 0); outimage;

   outfix(integrate(cube, 0, 2, 100), 4, 0); outimage;

   for i := 1 step 1 until 3 do begin u(i) := i; w(i) := 2 * i end;
   outfix(inner_product(u(i), w(i), i, 3), 1, 0); outimage
end
