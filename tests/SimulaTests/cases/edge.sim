begin
   ! procedure formelle dont l'effectif a un parametre par nom ;
   procedure p(q); procedure q; begin integer z; q(z); outint(z, 4) end;
   procedure fixe(x); name x; integer x; x := 42;
   ! parametre texte par nom : affectation de valeur et de reference ;
   procedure tx(t); name t; text t; begin t := "XY"; outtext(t); t :- "ref"; end;
   ! classe avec parametre texte par valeur et tableau ;
   class enreg(nom, notes); value nom; text nom; real array notes;
   begin real procedure moyenne; begin integer i; real s;
      for i := lowerbound(notes, 1) step 1 until upperbound(notes, 1) do s := s + notes(i);
      moyenne := s / (upperbound(notes, 1) - lowerbound(notes, 1) + 1) end;
   end;
   ! aiguillage virtuel ;
   class automate; virtual: switch etat;
   begin integer k; k := 2; goto etat(k); end;
   automate class auto2;
   begin switch etat := e1, e2;
e1: outtext("etat 1"); goto fin;
e2: outtext("etat 2");
fin: outimage
   end;
   ! detach dans un bloc prefixe : sans effet ;
   class pref; begin detach; outtext("apres detach"); outimage; inner end;
   ! effectifs de type fonction reevalues a chaque utilisation ;
   integer cpt;
   integer procedure suivant; begin cpt := cpt + 1; suivant := cpt end;
   integer procedure trois_fois(e); name e; integer e; trois_fois := e + e * 10 + e * 100;
   ref(enreg) r; real array ns(1:4); text t; integer i;
   ref(enreg) array tab(1:2);

   p(fixe); outimage;
   t :- blanks(4); tx(t); outtext("|"); outtext(t); outimage;
   for i := 1 step 1 until 4 do ns(i) := i * 2.5;
   r :- new enreg("Durand", ns); outtext(r.nom); outfix(r.moyenne, 2, 8); outimage;
   new auto2;
   pref begin outtext("corps du bloc"); outimage end;
   outint(trois_fois(suivant), 6); outimage;
   for r :- new enreg("a", ns), new enreg("b", ns) do outtext(r.nom); outimage;
   tab(1) :- r; outtext(tab(1).nom); outimage
end
