begin
   ! formal procedure whose actual has a name parameter ;
   procedure p(q); procedure q; begin integer z; q(z); outint(z, 4) end;
   procedure fix42(x); name x; integer x; x := 42;
   ! text parameter by name: value and reference assignment ;
   procedure tx(t); name t; text t; begin t := "XY"; outtext(t); t :- "ref"; end;
   ! class with a text parameter by value and an array ;
   class record_c(rname, marks); value rname; text rname; real array marks;
   begin real procedure average; begin integer i; real s;
      for i := lowerbound(marks, 1) step 1 until upperbound(marks, 1) do s := s + marks(i);
      average := s / (upperbound(marks, 1) - lowerbound(marks, 1) + 1) end;
   end;
   ! virtual switch ;
   class automaton; virtual: switch state;
   begin integer k; k := 2; goto state(k); end;
   automaton class auto2;
   begin switch state := e1, e2;
e1: outtext("state 1"); goto done;
e2: outtext("state 2");
done: outimage
   end;
   ! detach in a prefixed block: no effect ;
   class pref; begin detach; outtext("after detach"); outimage; inner end;
   ! function actuals re-evaluated at every use ;
   integer counter;
   integer procedure next_value; begin counter := counter + 1; next_value := counter end;
   integer procedure three_times(e); name e; integer e; three_times := e + e * 10 + e * 100;
   ref(record_c) r; real array ns(1:4); text t; integer i;
   ref(record_c) array table(1:2);

   p(fix42); outimage;
   t :- blanks(4); tx(t); outtext("|"); outtext(t); outimage;
   for i := 1 step 1 until 4 do ns(i) := i * 2.5;
   r :- new record_c("Durand", ns); outtext(r.rname); outfix(r.average, 2, 8); outimage;
   new auto2;
   pref begin outtext("block body"); outimage end;
   outint(three_times(next_value), 6); outimage;
   for r :- new record_c("a", ns), new record_c("b", ns) do outtext(r.rname); outimage;
   table(1) :- r; outtext(table(1).rname); outimage
end
