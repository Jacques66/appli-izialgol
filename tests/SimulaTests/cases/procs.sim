begin
   integer i, k; real r; integer array a(1:5);
   integer procedure fact(n); integer n;
      fact := if n <= 1 then 1 else n * fact(n - 1);
   real procedure sum(i, lo, hi, term); name i, term; integer i, lo, hi; real term;
   begin real s;
      i := lo;
      while i <= hi do begin s := s + term; i := i + 1 end;
      sum := s
   end;
   procedure swap(x, y); name x, y; integer x, y;
   begin integer t; t := x; x := y; y := t end;
   procedure incr(x); name x; integer x; x := x + 1;
   procedure byval(x); integer x; x := x + 100;
   real procedure apply(f, x); real procedure f; real x; apply := f(x);
   real procedure square(x); real x; square := x * x;
   procedure twice(p); procedure p; begin p; p end;
   procedure hello; outtext("hello ");
   integer procedure counter; begin k := k + 1; counter := k end;
   procedure settext(t); text t; t := "abc";
   procedure reftext(t); name t; text t; t :- "nouveau";
   text procedure greet(name_); text name_; greet :- "Bonjour " & name_;
   boolean procedure even(n); integer n; even := mod(n, 2) = 0;
   integer procedure ackermann(m, n); integer m, n;
      ackermann := if m = 0 then n + 1 else if n = 0 then ackermann(m - 1, 1)
                   else ackermann(m - 1, ackermann(m, n - 1));
   procedure fillarr(b, n); integer array b; integer n;
   begin integer j; for j := 1 step 1 until n do b(j) := j * j end;
   integer procedure total(b); value b; integer array b;
   begin integer j, s; for j := lowerbound(b, 1) step 1 until upperbound(b, 1) do begin s := s + b(j); b(j) := 0 end; total := s end;
   text t;

   outint(fact(10), 10); outimage;
   outfix(sum(i, 1, 100, i), 1, 10); outfix(sum(i, 1, 10, 1 / (i * i)), 6, 12); outimage;
   i := 3; k := 7; swap(i, k); outint(i, 3); outint(k, 3); outimage;
   a(2) := 5; i := 2; incr(a(i)); outint(a(2), 3); byval(i); outint(i, 3); outimage;
   outfix(apply(square, 3), 2, 8); outfix(apply(sqrt, 2), 4, 8); outimage;
   twice(hello); outimage;
   k := 0; outint(counter + counter * 10, 4); outimage;
   t :- blanks(5); settext(t); outtext("[" & t & "]"); reftext(t); outtext(t); outimage;
   outtext(greet("Simula")); outimage;
   outtext(if even(4) and not even(7) then "pair ok" else "pair faux"); outimage;
   outint(ackermann(2, 3), 4); outimage;
   fillarr(a, 5); outint(total(a), 5); outint(a(3), 4); outimage;
   r := 1; incr(i); outint(i, 3); outimage
end
