simulation begin
   ref(head) waiting_line;
   integer served;

   process class customer(number); integer number;
   begin
      outfix(time, 1, 6); outtext(": arrival of customer "); outint(number, 0); outimage;
      wait(waiting_line);
      outfix(time, 1, 6); outtext(": departure of customer "); outint(number, 0); outimage;
      served := served + 1
   end;

   process class desk;
   begin ref(customer) c;
      while true do
      begin
         if waiting_line.empty then passivate
         else
         begin
            c :- waiting_line.first;
            c.out;
            outfix(time, 1, 6); outtext(": service starts for "); outint(c.number, 0); outimage;
            hold(3);
            activate c
         end
      end
   end;

   process class generator;
   begin integer i;
      for i := 1 step 1 until 4 do
      begin
         activate new customer(i);
         if desk1.idle then activate desk1;
         hold(2)
      end
   end;

   ref(desk) desk1;
   waiting_line :- new head;
   desk1 :- new desk;
   activate new generator;
   hold(50);
   outtext("customers served: "); outint(served, 0); outimage;
   outtext("final time: "); outfix(time, 1, 0); outimage
end
