begin
   integer i, j, n; real array m(1:3, 0:2); integer array v(-2:2);
   switch s := l1, l2, if n > 0 then l3 else l1;
   text array names(1:3);
   boolean b; text tt;

   ! goto and switch ;
   n := 0;
   i := 1;
again:
   goto s(i);
l1: outtext("l1 "); i := 2; goto again;
l2: outtext("l2 "); n := 1; i := 3; goto again;
l3: outtext("l3"); outimage;

   ! arrays ;
   for i := 1 step 1 until 3 do for j := 0 step 1 until 2 do m(i, j) := i * 10 + j;
   outfix(m(2, 1), 1, 6); outfix(m(3, 2), 1, 6);
   outint(lowerbound(m, 2), 3); outint(upperbound(m, 1), 3); outimage;
   for i := -2 step 1 until 2 do v(i) := i * i;
   for i := 2 step -1 until -2 do outint(v(i), 3); outimage;

   ! for lists ;
   for i := 1, 5, 10 step 5 until 25, 100 do outint(i, 4); outimage;
   j := 0;
   for i := 1, i * 2 while i < 50 do outint(i, 4); outimage;
   tt :- blanks(1); for tt := "a", "b" do outtext(tt); outimage;
   for b := true, false do outtext(if b then "V" else "F"); outimage;
   for i := 10 step -3 until 0 do outint(i, 3); outimage;
   for i := 1 step 1 until 0 do outtext("never"); outint(i, 3); outimage;

   ! nested blocks and procedure with a non-local goto ;
   begin
      procedure leave(k); integer k; if k > 2 then goto finished;
      for i := 1 step 1 until 10 do begin outint(i, 3); leave(i) end;
finished: outtext(" exit"); outimage
   end;

   ! constants ;
   begin integer hundred = 100; real half = 0.5; text greeting = "hello";
      outint(hundred, 4); outfix(half, 2, 6); outtext(" "); outtext(greeting); outimage
   end;

   ! conditional expressions and Booleans ;
   b := 3 > 2 imp 1 > 2; outtext(if b then "imp true" else "imp false"); outimage;
   b := (1 = 1) eqv (2 = 2); outtext(if b then "eqv true" else "eqv false"); outimage;
   i := 0;
   if i <> 0 and then 10 // i > 1 then outtext("no") else outtext("and then ok"); outimage;
   if i = 0 or else 10 // i > 1 then outtext("or else ok"); outimage;
   outint(sourceline, 4); outimage;
   inspect sysout do outtext("sysout connected"); outimage;
   outint(sysout.pos, 3); outimage
end
