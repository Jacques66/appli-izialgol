begin
   integer i, j, n; real array m(1:3, 0:2); integer array v(-2:2);
   switch s := l1, l2, if n > 0 then l3 else l1;
   text array noms(1:3);
   boolean b; text tt;

   ! goto et switch ;
   n := 0;
   i := 1;
debut:
   goto s(i);
l1: outtext("l1 "); i := 2; goto debut;
l2: outtext("l2 "); n := 1; i := 3; goto debut;
l3: outtext("l3"); outimage;

   ! tableaux ;
   for i := 1 step 1 until 3 do for j := 0 step 1 until 2 do m(i, j) := i * 10 + j;
   outfix(m(2, 1), 1, 6); outfix(m(3, 2), 1, 6);
   outint(lowerbound(m, 2), 3); outint(upperbound(m, 1), 3); outimage;
   for i := -2 step 1 until 2 do v(i) := i * i;
   for i := 2 step -1 until -2 do outint(v(i), 3); outimage;

   ! listes du for ;
   for i := 1, 5, 10 step 5 until 25, 100 do outint(i, 4); outimage;
   j := 0;
   for i := 1, i * 2 while i < 50 do outint(i, 4); outimage;
   tt :- blanks(1); for tt := "a", "b" do outtext(tt); outimage;
   for b := true, false do outtext(if b then "V" else "F"); outimage;
   for i := 10 step -3 until 0 do outint(i, 3); outimage;
   for i := 1 step 1 until 0 do outtext("jamais"); outint(i, 3); outimage;

   ! blocs imbriques et procedure avec goto non local ;
   begin
      procedure sortie(k); integer k; if k > 2 then goto fini;
      for i := 1 step 1 until 10 do begin outint(i, 3); sortie(i) end;
fini: outtext(" sortie"); outimage
   end;

   ! constantes ;
   begin integer cent = 100; real demi = 0.5; text salut = "salut";
      outint(cent, 4); outfix(demi, 2, 6); outtext(" "); outtext(salut); outimage
   end;

   ! expressions conditionnelles et booleens ;
   b := 3 > 2 imp 1 > 2; outtext(if b then "imp vrai" else "imp faux"); outimage;
   b := (1 = 1) eqv (2 = 2); outtext(if b then "eqv vrai" else "eqv faux"); outimage;
   i := 0;
   if i <> 0 and then 10 // i > 1 then outtext("non") else outtext("and then ok"); outimage;
   if i = 0 or else 10 // i > 1 then outtext("or else ok"); outimage;
   outint(sourceline, 4); outimage;
   inspect sysout do outtext("sysout connecte"); outimage;
   outint(sysout.pos, 3); outimage
end
