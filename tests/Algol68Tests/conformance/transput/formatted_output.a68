# RR 10.3.4-10.3.5.1: formatted output, all pattern kinds #
printf(($"["5d"]"l$, 42));
printf(($"["5zd"]"l$, 42));
printf(($"["+5zd"]"l$, 42));
printf(($"["-5zd"]"l$, 42));
printf(($"["-5zd"]"l$, -42));
printf(($"["5z+d"]"l$, -42));
printf(($"["zzz-d"]"l$, 7));
printf(($"["3z","3z","3d"]"l$, 1234567));
printf(($"["d.3d"]"l$, 3.14159));
printf(($"["-zd.2d"]"l$, -3.14159));
printf(($"["+d.3de+2d"]"l$, 1234.5));
printf(($"["-d.3de-2d"]"l$, 0.00012345));
printf(($"["zd.dd"]"l$, 0.5));
printf(($"["b"]"l$, TRUE));
printf(($"["b("yes","no")"]"l$, FALSE));
printf(($"["c("a","b","c")"]"l$, 2));
printf(($"["5a"]"l$, "hello"));
printf(($"["a"]"l$, "x"));
printf(($"["2r8d"]"l$, 2r1011));
printf(($"["16r4d"]"l$, 16rbeef));
printf(($"["8r3zd"]"l$, 8r17));
printf(($"["g"]"l$, 42));
printf(($"["g(6)"]"l$, 42));
printf(($"["g(-6)"]"l$, 42));
printf(($"["g(10,3)"]"l$, 3.14159));
printf(($"["g(12,3,2)"]"l$, 3.14159));
printf(($"["g"]"l$, "str"));
printf(($"["d.2di d.2d"]"l$, 1.5 I 2.25));
printf(($"["3xa"]"l$, "q"));
printf(($"["n(2+1)d"]"l$, 7));
printf(($"["3(d" ")"]"l$, 1, 2, 3));
printf(($"["10k"*]"l$));
printf(($"["d"]",l$, 1, 2));
printf(($"["sdd"]"l$, 42));
printf(($"["dd.sdd"]"l$, 12.34));
FORMAT f = $"<"g">"$; printf((f, 1, f, 2)); print(newline);
printf(($"["f(f)"]"l$, 9));
printf(($"["2(2d)"]"l$, 12, 34))
;
printf(($"["-zzd"]"l$, -123));
printf(($"["d.de+2d"]"l$, 1.0e15));
printf(($"["+.3de+2d"]"l$, 12.5));
printf(($"["zd.3d"]"l$, 1));
printf(($"["+d.3d"]"l$, LONG 1.5));
printf(($"["+3zd"]"l$, LONG 42));
printf(($"["g"]"l$, LONG 1.5));
printf(($"["g(0)"]"l$, -7));
printf(($"["g(0,2)"]"l$, -7.256));
printf(($"["2r32d"]"l$, LONG 2r1));
printf(($"["b"]", "["b"]"l$, TRUE, FALSE))
