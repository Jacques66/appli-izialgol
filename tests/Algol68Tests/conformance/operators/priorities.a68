# RR 10.2.3.0: standard priorities; monadic operators bind most tightly; dyadic ones associate to the left #
print((1 + 2 * 3 ** 2, 2 ** 3 ** 2, 10 - 3 - 2, 100 % 7 % 3, newline));
print((TRUE OR FALSE AND FALSE, NOT TRUE OR TRUE, 1 < 2 = TRUE, newline));
print((- 2 ** 2, ABS - 3 * 2, newline));
print((1 I 2 + 3, newline));
print((32 ELEM 2r1 AND TRUE, newline));
[1:2, 1:3] INT m; print((2 UPB m * 2, UPB m + 1, 1 LWB m - 1, newline));
INT a := 1; a +:= 2 * 3; print((a, newline));
print((1 + 2 = 3 AND 4 > 3, newline));
print((7 MOD 4 * 2, 7 OVER 2 * 2, newline));
print((2r1100 SHL 1 = 2r11000, newline));
PRIO MAXI = 6; OP MAXI = (INT x, y) INT: (x > y | x | y);
print((1 MAXI 5 * 2, 3 * 1 MAXI 2, newline));
OP (INT, INT) INT MINI = (INT x, y) INT: (x < y | x | y); PRIO MINI = 9;
print((10 - 2 MINI 7, newline))
