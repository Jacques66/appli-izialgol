<Window x:Class="Studio.Ide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:Studio.Ide.Panels"
        Title="AlgolStudio" Height="820" Width="1280" MinWidth="640" MinHeight="420"
        Icon="Assets/app.ico" AllowDrop="True"
        Background="{DynamicResource Brush.WindowBackground}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <!-- ============================== Menu ============================== -->
        <Menu DockPanel.Dock="Top" Padding="2,2,2,0">
            <MenuItem Header="_File">
                <MenuItem Header="New _Simula 67 program" Command="{Binding CmdNewSimula}" InputGestureText="Ctrl+N">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New _Algol 68 program" Command="{Binding CmdNewAlgol}" InputGestureText="Ctrl+Shift+N">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconGreen}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New Algol 6_0 program" Command="{Binding CmdNewAlgol60}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconOrange}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New Simula _I program" Command="{Binding CmdNewSimulaI}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconRed}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New _Pascal program" Command="{Binding CmdNewPascal}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconPurple}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="NewEchoItem" Header="New _Echo program (test)" Command="{Binding CmdNewEcho}" Visibility="Collapsed"/>
                <Separator/>
                <MenuItem Header="_Open…" Command="{Binding CmdOpen}" InputGestureText="Ctrl+O">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Fill="{DynamicResource Brush.IconYellow}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open _folder…" Command="{Binding CmdOpenFolder}"/>
                <MenuItem x:Name="RecentFilesMenu" Header="_Recent files" SubmenuOpened="OnRecentMenuOpened">
                    <MenuItem Header="(none)" IsEnabled="False"/>
                </MenuItem>
                <MenuItem x:Name="RecentFoldersMenu" Header="Recent fol_ders" SubmenuOpened="OnRecentFoldersMenuOpened">
                    <MenuItem Header="(none)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding CmdSave}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _as…" Command="{Binding CmdSaveAs}"/>
                <MenuItem Header="Save a_ll" Command="{Binding CmdSaveAll}" InputGestureText="Ctrl+Shift+S">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.SaveAll}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Close" Command="{Binding CmdClose}" InputGestureText="Ctrl+W"/>
                <MenuItem Header="Close all" Command="{Binding CmdCloseAll}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding CmdExit}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="Undo" InputGestureText="Ctrl+Z">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo" Command="Redo" InputGestureText="Ctrl+Y">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Cu_t" Command="Cut" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copy" Command="Copy" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Paste" Command="Paste" InputGestureText="Ctrl+V"/>
                <MenuItem Header="Select _all" Command="SelectAll" InputGestureText="Ctrl+A"/>
                <Separator/>
                <MenuItem Header="_Find…" Command="{Binding CmdFind}" InputGestureText="Ctrl+F">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Find}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="R_eplace…" Command="{Binding CmdReplace}" InputGestureText="Ctrl+H"/>
                <MenuItem Header="Find _next" Command="{Binding CmdFindNext}" InputGestureText="F3"/>
                <MenuItem Header="Find pre_vious" Command="{Binding CmdFindPrevious}" InputGestureText="Shift+F3"/>
                <MenuItem Header="_Go to line…" Command="{Binding CmdGoToLine}" InputGestureText="Ctrl+G"/>
                <Separator/>
                <MenuItem Header="Complete _word" Command="{Binding CmdComplete}" InputGestureText="Ctrl+Space"/>
                <MenuItem Header="C_omment selection" Command="{Binding CmdComment}" InputGestureText="Ctrl+K">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Comment}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Uncomment selection" Command="{Binding CmdUncomment}" InputGestureText="Ctrl+Shift+K"/>
                <MenuItem Header="Re_indent selection" Command="{Binding CmdReindent}" InputGestureText="Ctrl+I"/>
                <Separator/>
                <MenuItem Header="Fold a_ll" Command="{Binding CmdFoldAll}" InputGestureText="Ctrl+M, Ctrl+O"/>
                <MenuItem Header="Unfol_d all" Command="{Binding CmdUnfoldAll}" InputGestureText="Ctrl+M, Ctrl+L"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ShowExplorerItem" Header="_Explorer" IsCheckable="True" Click="OnTogglePanels"/>
                <MenuItem x:Name="ShowOutlineItem" Header="_Outline" IsCheckable="True" Click="OnTogglePanels"/>
                <MenuItem x:Name="ShowBottomItem" Header="_Bottom panel" IsCheckable="True" Click="OnTogglePanels"/>
                <Separator/>
                <MenuItem Header="O_utput" Command="{Binding CmdShowPanel}" CommandParameter="output" InputGestureText="Ctrl+Alt+O"/>
                <MenuItem Header="Error _list" Command="{Binding CmdShowPanel}" CommandParameter="errors" InputGestureText="Ctrl+Alt+E"/>
                <MenuItem Header="_Console" Command="{Binding CmdShowPanel}" CommandParameter="console" InputGestureText="Ctrl+Alt+C"/>
                <MenuItem Header="Call _stack" Command="{Binding CmdShowPanel}" CommandParameter="stack" InputGestureText="Ctrl+Alt+P"/>
                <MenuItem Header="_Variables" Command="{Binding CmdShowPanel}" CommandParameter="variables" InputGestureText="Ctrl+Alt+V"/>
                <Separator/>
                <MenuItem Header="_Zoom in" Command="{Binding CmdZoomIn}" InputGestureText="Ctrl++"/>
                <MenuItem Header="Zoom ou_t" Command="{Binding CmdZoomOut}" InputGestureText="Ctrl+-"/>
                <MenuItem Header="_Normal size" Command="{Binding CmdZoomReset}" InputGestureText="Ctrl+0"/>
                <Separator/>
                <MenuItem x:Name="WordWrapItem" Header="_Word wrap" IsCheckable="True" Click="OnEditorOptionChanged"/>
                <MenuItem x:Name="LineNumbersItem" Header="Line _numbers" IsCheckable="True" Click="OnEditorOptionChanged"/>
                <MenuItem x:Name="WhitespaceItem" Header="Show w_hitespace" IsCheckable="True" Click="OnEditorOptionChanged"/>
                <Separator/>
                <MenuItem Header="_Theme">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Theme}"/></MenuItem.Icon>
                    <MenuItem x:Name="ThemeLightItem" Header="_Light" IsCheckable="True" Click="OnThemeLight"/>
                    <MenuItem x:Name="ThemeDarkItem" Header="_Dark" IsCheckable="True" Click="OnThemeDark"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Build">
                <MenuItem Header="_Build" Command="{Binding CmdBuild}" InputGestureText="F7">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Build}" Fill="{DynamicResource Brush.IconOrange}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Generate standalone .exe…" Command="{Binding CmdGenerateExe}" InputGestureText="Ctrl+Shift+E">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Package}" Fill="{DynamicResource Brush.IconPurple}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="LanguageMenu" Header="File _language" SubmenuOpened="OnLanguageMenuOpened"/>
                <Separator/>
                <MenuItem x:Name="BackgroundCheckItem" Header="Background _checking" IsCheckable="True" Click="OnBuildOptionChanged"/>
                <MenuItem x:Name="DebugInfoItem" Header="_Debug information in .exe files" IsCheckable="True" Click="OnBuildOptionChanged"/>
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem x:Name="DebugMenuItem" Header="_Start debugging" Command="{Binding CmdDebug}" InputGestureText="F5">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.IconGreen}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Run without debugging" Command="{Binding CmdRun}" InputGestureText="Ctrl+F5">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PlayOutline}" Fill="{DynamicResource Brush.IconGreen}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="S_top" Command="{Binding CmdStop}" InputGestureText="Shift+F5">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Stop}" Fill="{DynamicResource Brush.IconRed}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="R_estart" Command="{Binding CmdRestart}" InputGestureText="Ctrl+Shift+F5"/>
                <MenuItem Header="_Pause" Command="{Binding CmdPause}" InputGestureText="Ctrl+Alt+Pause">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Pause}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Step _into" Command="{Binding CmdStepInto}" InputGestureText="F11">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.StepInto}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step _over" Command="{Binding CmdStepOver}" InputGestureText="F10">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.StepOver}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step o_ut" Command="{Binding CmdStepOut}" InputGestureText="Shift+F11">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.StepOut}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Toggle _breakpoint" Command="{Binding CmdToggleBreakpoint}" InputGestureText="F9">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Breakpoint}" Fill="{DynamicResource Brush.IconRed}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Delete all breakpoints" Command="{Binding CmdClearBreakpoints}" InputGestureText="Ctrl+Shift+F9"/>
                <Separator/>
                <MenuItem x:Name="StopOnEntryItem" Header="Stop at _first statement" IsCheckable="True" Click="OnDebugOptionChanged"/>
                <MenuItem x:Name="BreakOnErrorItem" Header="Break on runtime _error" IsCheckable="True" Click="OnDebugOptionChanged"/>
                <MenuItem x:Name="ExternalConsoleItem" Header="Run in e_xternal Windows console" IsCheckable="True" Click="OnDebugOptionChanged"/>
            </MenuItem>
            <MenuItem x:Name="ExamplesMenu" Header="E_xamples" SubmenuOpened="OnExamplesMenuOpened">
                <MenuItem Header="(no examples found)" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Simula 67 help" Command="{Binding CmdHelp}" CommandParameter="simula">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Algol 68 help" Command="{Binding CmdHelp}" CommandParameter="algol68">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconGreen}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Algol 6_0 help" Command="{Binding CmdHelp}" CommandParameter="algol60">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconOrange}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Simula _I help" Command="{Binding CmdHelp}" CommandParameter="simula1">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconRed}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Pascal help" Command="{Binding CmdHelp}" CommandParameter="pascal">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconPurple}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Help for the _current file's language" Command="{Binding CmdHelp}" InputGestureText="F1"/>
                <MenuItem Header="_Keyboard shortcuts" Command="{Binding CmdHelp}" CommandParameter="shortcuts"/>
                <Separator/>
                <MenuItem Header="_About AlgolStudio" Command="{Binding CmdAbout}"/>
            </MenuItem>
        </Menu>

        <!-- ============================== Toolbar ============================== -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,3">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdNewSimula}" ToolTip="New Simula 67 program (Ctrl+N)">
                    <Grid>
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconBlue}"/>
                        <TextBlock Text="S" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.IconBlue}" Margin="6,6,0,0"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdNewAlgol}" ToolTip="New Algol 68 program (Ctrl+Shift+N)">
                    <Grid>
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconGreen}"/>
                        <TextBlock Text="A" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.IconGreen}" Margin="6,6,0,0"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdOpen}" ToolTip="Open (Ctrl+O)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Fill="{DynamicResource Brush.IconYellow}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdSave}" ToolTip="Save (Ctrl+S)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdSaveAll}" ToolTip="Save all (Ctrl+Shift+S)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.SaveAll}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Border Width="1" Margin="5,2" Background="{DynamicResource Brush.Border}"/>
                <Button Style="{StaticResource ToolButton}" Command="Undo" ToolTip="Undo (Ctrl+Z)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="Redo" ToolTip="Redo (Ctrl+Y)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdFind}" ToolTip="Find / replace (Ctrl+F, Ctrl+H)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Find}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdToggleComment}" ToolTip="Comment / uncomment (Ctrl+K)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Comment}"/>
                </Button>
                <Border Width="1" Margin="5,2" Background="{DynamicResource Brush.Border}"/>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdBuild}" ToolTip="Build (F7)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Build}" Fill="{DynamicResource Brush.IconOrange}"/>
                        <TextBlock Text="Build" Margin="4,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdDebug}" ToolTip="Start debugging / Continue (F5)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.IconGreen}"/>
                        <TextBlock x:Name="DebugButtonText" Text="Debug" Margin="4,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdRun}" ToolTip="Run without debugging (Ctrl+F5)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PlayOutline}" Fill="{DynamicResource Brush.IconGreen}"/>
                        <TextBlock Text="Run" Margin="4,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdPause}" ToolTip="Pause (Ctrl+Alt+Pause)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Pause}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdStop}" ToolTip="Stop (Shift+F5)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Stop}" Fill="{DynamicResource Brush.IconRed}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdStepInto}" ToolTip="Step into (F11)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.StepInto}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdStepOver}" ToolTip="Step over (F10)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.StepOver}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdStepOut}" ToolTip="Step out (Shift+F11)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.StepOut}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdToggleBreakpoint}" ToolTip="Toggle breakpoint (F9)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Breakpoint}" Fill="{DynamicResource Brush.IconRed}"/>
                </Button>
                <Border Width="1" Margin="5,2" Background="{DynamicResource Brush.Border}"/>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdGenerateExe}" ToolTip="Generate standalone .exe (Ctrl+Shift+E)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Package}" Fill="{DynamicResource Brush.IconPurple}"/>
                        <TextBlock Text=".exe" Margin="4,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="ExternalConsoleToggle" Style="{StaticResource ToolToggle}" Click="OnExternalConsoleToggle"
                              ToolTip="Run in an external Windows console">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Console}"/>
                </ToggleButton>
                <Border Width="1" Margin="5,2" Background="{DynamicResource Brush.Border}"/>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CmdHelp}" ToolTip="Help (F1)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================== Status bar ============================== -->
        <Border x:Name="StatusBarBorder" DockPanel.Dock="Bottom" Background="{DynamicResource Brush.StatusBar}" Padding="8,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="StatusPosition" Foreground="{DynamicResource Brush.StatusBarText}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusInsert" Foreground="{DynamicResource Brush.StatusBarText}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusEncoding" Foreground="{DynamicResource Brush.StatusBarText}" Margin="12,0" VerticalAlignment="Center"/>
                    <Button x:Name="StatusLanguage" Style="{StaticResource ToolButton}" Padding="6,0" Click="OnStatusLanguageClick"
                            ToolTip="File language (click to change)">
                        <TextBlock x:Name="StatusLanguageText" Foreground="{DynamicResource Brush.StatusBarText}" FontWeight="SemiBold"/>
                    </Button>
                    <TextBlock x:Name="StatusZoom" Foreground="{DynamicResource Brush.StatusBarText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusState" Foreground="{DynamicResource Brush.StatusBarText}" FontWeight="SemiBold" VerticalAlignment="Center" Text="Ready"/>
                <TextBlock x:Name="StatusMessage" Foreground="{DynamicResource Brush.StatusBarText}" Margin="16,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ============================== Main area ============================== -->
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition x:Name="BottomSplitterRow" Height="5"/>
                <RowDefinition x:Name="BottomRow" Height="220"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="230"/>
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition x:Name="RightSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="RightColumn" Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Explorer -->
            <DockPanel x:Name="ExplorerPanel" Grid.Column="0" Background="{DynamicResource Brush.PanelBackground}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelHeader}" Height="28"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" Padding="3" Command="{Binding CmdOpenFolder}" ToolTip="Open folder…">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Fill="{DynamicResource Brush.IconYellow}"/>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Padding="3" Click="OnExplorerRefresh" ToolTip="Refresh">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}"/>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Padding="3" Click="OnExplorerCollapse" ToolTip="Collapse all">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Collapse}"/>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="ExplorerTitle" Text="EXPLORER" Style="{StaticResource PanelHeaderText}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <TreeView x:Name="ExplorerTree" MouseDoubleClick="OnExplorerDoubleClick" KeyDown="OnExplorerKeyDown"
                          VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="OnExplorerOpen"/>
                            <MenuItem Header="Open in Windows Explorer" Click="OnExplorerReveal"/>
                            <Separator/>
                            <MenuItem Header="Refresh" Click="OnExplorerRefresh"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Grid Width="16" Height="16">
                                    <Path Style="{StaticResource IconPath}" Data="{Binding Icon}" Fill="{Binding IconBrush}"/>
                                    <TextBlock Text="{Binding Badge}" FontSize="7.5" FontWeight="Bold" Foreground="{Binding IconBrush}"
                                               Margin="6,6,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- Editors -->
            <Grid Grid.Column="2">
                <TabControl x:Name="DocTabs" Style="{StaticResource DocTabControl}" SelectionChanged="OnDocTabChanged"/>
                <ScrollViewer x:Name="WelcomePanel" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Welcome}">
                    <StackPanel Margin="48,36" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/app256.png" Width="64" Height="64"/>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AlgolStudio" FontSize="26" FontWeight="Light"/>
                                <TextBlock Text="A development environment for great historic languages: Simula 67, Algol 68, Algol 60, Simula I and Pascal"
                                           Foreground="{DynamicResource Brush.TextDim}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdNewSimula}" Content="New Simula 67 program"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdNewAlgol}" Content="New Algol 68 program"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdNewAlgol60}" Content="New Algol 60 program"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdNewSimulaI}" Content="New Simula I program"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdNewPascal}" Content="New Pascal program"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdOpen}" Content="Open a file…"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdOpenFolder}" Content="Open a folder…"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="simula" Content="Simula 67 help"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="algol68" Content="Algol 68 help"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="algol60" Content="Algol 60 help"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="simula1" Content="Simula I help"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="pascal" Content="Pascal help"/>
                                <TextBlock Text="Recent files" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
                                <ItemsControl x:Name="WelcomeRecent">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Click="OnWelcomeRecentClick" Tag="{Binding}" ToolTip="{Binding}">
                                                <TextBlock Text="{Binding Converter={x:Static panels:FileNameConverter.Instance}}"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="WelcomeNoRecent" Text="(none)" Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                <TextBlock Text="Examples" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="WelcomeSamples">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Click="OnWelcomeRecentClick" Tag="{Binding}" ToolTip="{Binding}">
                                                <TextBlock Text="{Binding Converter={x:Static panels:SampleNameConverter.Instance}}"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="WelcomeNoSamples" Text="(samples folder not found)" Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,28,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}">
                            Shortcuts: F7 build · F5 debug · Ctrl+F5 run · F9 breakpoint · F10/F11 step ·
                            Ctrl+Space complete · Ctrl+F find · F1 help. Drag and drop files onto the window to open them.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- Outline -->
            <DockPanel x:Name="OutlinePanel" Grid.Column="4" Background="{DynamicResource Brush.PanelBackground}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelHeader}" Height="28"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="OutlineTitle" Text="OUTLINE" Style="{StaticResource PanelHeaderText}" TextTrimming="CharacterEllipsis"/>
                </Border>
                <TextBox x:Name="OutlineFilter" DockPanel.Dock="Top" Margin="4" TextChanged="OnOutlineFilterChanged"
                         ToolTip="Filter the outline"/>
                <TextBlock x:Name="OutlineEmpty" DockPanel.Dock="Top" Margin="10,6" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}"
                           Text="No procedure, class, operator or mode."/>
                <ListBox x:Name="OutlineList" SelectionMode="Single" MouseLeftButtonUp="OnOutlineClick" KeyDown="OnOutlineKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip="{Binding ToolTipText}">
                                <Border Width="16" Height="16" CornerRadius="3" Background="{Binding Badge}">
                                    <TextBlock Text="{Binding Letter}" Foreground="White" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Detail}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextDim}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Grid.ColumnSpan="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

            <!-- ============================== Bottom panel ============================== -->
            <TabControl x:Name="BottomTabs" Grid.Row="2" Grid.ColumnSpan="5" Style="{StaticResource PanelTabControl}"
                        ItemContainerStyle="{StaticResource PanelTabItem}">
                <TabItem x:Name="OutputTab" Header="Output">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,2">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolButton}" Click="OnClearOutput" ToolTip="Clear the output">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Clear}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="OutputBox" IsReadOnly="True" BorderThickness="0" FontFamily="{StaticResource CodeFont}" FontSize="12.5"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 Background="{DynamicResource Brush.EditorBackground}" MouseDoubleClick="OnOutputDoubleClick"
                                 ToolTip="Double-click a diagnostic to go to its line">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}">
                                        <ScrollViewer x:Name="PART_ContentHost" Padding="4,2"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="ErrorsTab">
                    <TabItem.Header>
                        <TextBlock x:Name="ErrorsTabHeader" Text="Errors"/>
                    </TabItem.Header>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,2">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="FilterErrors" Style="{StaticResource ToolToggle}" IsChecked="True" Click="OnErrorFilterChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ErrorMark}" Fill="{DynamicResource Brush.Error}"/>
                                        <TextBlock x:Name="FilterErrorsText" Text="0 errors" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="FilterWarnings" Style="{StaticResource ToolToggle}" IsChecked="True" Click="OnErrorFilterChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.WarningMark}" Fill="{DynamicResource Brush.Warning}"/>
                                        <TextBlock x:Name="FilterWarningsText" Text="0 warnings" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="FilterInfos" Style="{StaticResource ToolToggle}" IsChecked="True" Click="OnErrorFilterChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.InfoMark}" Fill="{DynamicResource Brush.Info}"/>
                                        <TextBlock x:Name="FilterInfosText" Text="0 messages" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                        <ListView x:Name="ErrorList" MouseDoubleClick="OnErrorDoubleClick" KeyDown="OnErrorKeyDown">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="28">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Path Style="{StaticResource IconPath}" Data="{Binding Icon}" Fill="{Binding IconBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Description" Width="620">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="File" Width="160" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="Line" Width="55" DisplayMemberBinding="{Binding LineText}"/>
                                    <GridViewColumn Header="Col." Width="45" DisplayMemberBinding="{Binding ColumnText}"/>
                                    <GridViewColumn Header="Origin" Width="90" DisplayMemberBinding="{Binding Origin}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="ConsoleTab" Header="Console">
                    <panels:ConsolePanel x:Name="ConsoleView"/>
                </TabItem>
                <TabItem x:Name="StackTab" Header="Call stack">
                    <Grid>
                        <ListView x:Name="StackList" MouseDoubleClick="OnStackDoubleClick" KeyDown="OnStackKeyDown">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="26">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Arrow}" Fill="{Binding MarkerBrush}"
                                                      Visibility="{Binding MarkerVisibility}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Procedure / block" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="File" Width="200" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="Line" Width="60" DisplayMemberBinding="{Binding LineText}"/>
                                    <GridViewColumn Header="Col." Width="50" DisplayMemberBinding="{Binding ColumnText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="StackEmpty" Margin="10" Foreground="{DynamicResource Brush.TextDim}"
                                   Text="The call stack is shown when the program is paused in the debugger."/>
                    </Grid>
                </TabItem>
                <TabItem x:Name="VariablesTab" Header="Variables">
                    <Grid>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelHeader}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,0,0,1" Padding="8,3">
                                <TextBlock x:Name="VariablesHeader" Foreground="{DynamicResource Brush.TextDim}" Text="Name = value   (type)"/>
                            </Border>
                            <TreeView x:Name="VariablesTree" FontFamily="{StaticResource CodeFont}" FontSize="12.5">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text=" = " Foreground="{DynamicResource Brush.TextDim}"/>
                                            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="{Binding TypeSuffix}" Foreground="{DynamicResource Brush.TextDim}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                        <TextBlock x:Name="VariablesEmpty" Margin="10,34,10,10" Foreground="{DynamicResource Brush.TextDim}"
                                   Text="Variables are shown when the program is paused in the debugger."/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
