<Window x:Class="Studio.Ide.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos" SizeToContent="Height" Width="520" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.PanelBackground}"
        Foreground="{DynamicResource Brush.Text}" FontFamily="{StaticResource UiFont}" FontSize="12.5">
    <StackPanel Margin="22">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/app256.png" Width="72" Height="72"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Simula 67 &amp; Algol 68 Studio" FontSize="22" FontWeight="Light"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource Brush.TextDim}"/>
            </StackPanel>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,18,0,0">
            Environnement de développement intégré pour Simula 67 (Dahl et Nygaard, 1967 — le premier langage à objets :
            classes, héritage, coroutines, simulation) et Algol 68 (van Wijngaarden et al., 1968 — modes, opérateurs,
            orthogonalité).
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
            Éditeur avec coloration syntaxique, repliage et complétion ; compilation, liste d'erreurs, console intégrée,
            débogueur (points d'arrêt, pas à pas, pile, variables) et génération d'exécutables Windows autonomes.
            Outils en ligne de commande : simc (Simula 67) et a68c (Algol 68).
        </TextBlock>
        <TextBlock x:Name="RuntimeText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextDim}"/>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextDim}">
            Éditeur de texte : AvalonEdit (licence MIT). Rendu de l'aide : Markdig (licence BSD-2).
        </TextBlock>
        <Button Style="{StaticResource DialogButton}" Content="Fermer" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
