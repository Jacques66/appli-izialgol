<dialogs:DialogWindow x:Class="Studio.Ide.Dialogs.GoToLineWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:Studio.Ide.Dialogs"
        Title="Go to Line" SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/app.ico" Background="{DynamicResource Brush.PanelBackground}"
        Foreground="{DynamicResource Brush.Text}" FontFamily="{StaticResource UiFont}" FontSize="12.5">
    <StackPanel Margin="16" Width="300">
        <TextBlock x:Name="Prompt" Margin="0,0,0,6"/>
        <TextBox x:Name="LineBox"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Error}" Margin="0,4,0,0" IsVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Theme="{StaticResource DialogButton}" Content="OK" IsDefault="True" Click="OnOk"/>
            <Button Theme="{StaticResource DialogButton}" Content="Cancel" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
