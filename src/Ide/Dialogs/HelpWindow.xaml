<Window x:Class="Studio.Ide.Dialogs.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aide — Simula 67 &amp; Algol 68 Studio" Width="1080" Height="760" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.PanelBackground}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="160"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="8">
                <TextBlock Text="SUJETS" Style="{StaticResource PanelHeaderText}" Margin="0,0,0,4"/>
                <ListBox x:Name="TopicList" SelectionChanged="OnTopicChanged" FontSize="13">
                    <ListBoxItem Tag="simula" Content="Simula 67"/>
                    <ListBoxItem Tag="algol68" Content="Algol 68"/>
                    <ListBoxItem Tag="shortcuts" Content="Raccourcis clavier"/>
                    <ListBoxItem Tag="ide" Content="Utiliser l'environnement"/>
                </ListBox>
                <TextBlock Text="SOMMAIRE" Style="{StaticResource PanelHeaderText}" Margin="0,14,0,4"/>
            </StackPanel>
            <ListBox x:Name="TocList" Margin="8,0,8,8" MouseLeftButtonUp="OnTocClick" KeyDown="OnTocKey"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
        <WebBrowser x:Name="Browser" Grid.Column="2" Navigating="OnNavigating" LoadCompleted="OnLoadCompleted"/>
    </Grid>
</Window>
