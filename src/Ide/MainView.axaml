<!-- Main view of the IDE: hosted by MainWindow on the desktop, the whole page in the browser. -->
<UserControl x:Class="Studio.Ide.MainView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:Studio.Ide.Panels"
        xmlns:ae="using:AvaloniaEdit"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource Brush.WindowBackground}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5">
    <DockPanel>
        <!-- ============================== Menu ============================== -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="2,2,2,0">
            <MenuItem Header="_File">
                <MenuItem Header="New _Simula 67 program" Command="{Binding CmdNewSimula}" InputGesture="Ctrl+N">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New _Algol 68 program" Command="{Binding CmdNewAlgol}" InputGesture="Ctrl+Shift+N">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconGreen}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New Algol 6_0 program" Command="{Binding CmdNewAlgol60}">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconOrange}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New Simula _I program" Command="{Binding CmdNewSimulaI}">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconRed}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New _Pascal program" Command="{Binding CmdNewPascal}">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconPurple}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="NewEchoItem" Header="New _Echo program (test)" Command="{Binding CmdNewEcho}" IsVisible="False"/>
                <Separator/>
                <MenuItem Header="_Open…" Command="{Binding CmdOpen}" InputGesture="Ctrl+O">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Fill="{DynamicResource Brush.IconYellow}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="OpenFolderItem" Header="Open _folder…" Command="{Binding CmdOpenFolder}"/>
                <MenuItem x:Name="RecentFilesMenu" Header="_Recent files" SubmenuOpened="OnRecentMenuOpened">
                    <MenuItem Header="(none)" IsEnabled="False"/>
                </MenuItem>
                <MenuItem x:Name="RecentFoldersMenu" Header="Recent fol_ders" SubmenuOpened="OnRecentFoldersMenuOpened">
                    <MenuItem Header="(none)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding CmdSave}" InputGesture="Ctrl+S">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _as…" Command="{Binding CmdSaveAs}"/>
                <MenuItem Header="Save a_ll" Command="{Binding CmdSaveAll}" InputGesture="Ctrl+Shift+S">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.SaveAll}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="DownloadItem" Header="_Download to the computer…" Command="{Binding CmdDownload}" IsVisible="False"/>
                <Separator/>
                <MenuItem Header="_Close" Command="{Binding CmdClose}" InputGesture="Ctrl+W"/>
                <MenuItem Header="Close all" Command="{Binding CmdCloseAll}"/>
                <Separator x:Name="ExitSeparator"/>
                <MenuItem x:Name="ExitItem" Header="E_xit" Command="{Binding CmdExit}" InputGesture="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding CmdUndo}" InputGesture="Ctrl+Z">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo" Command="{Binding CmdRedo}" InputGesture="Ctrl+Y">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Cu_t" Command="{Binding CmdCut}" InputGesture="Ctrl+X"/>
                <MenuItem Header="_Copy" Command="{Binding CmdCopy}" InputGesture="Ctrl+C"/>
                <MenuItem Header="_Paste" Command="{Binding CmdPaste}" InputGesture="Ctrl+V"/>
                <MenuItem Header="Select _all" Command="{Binding CmdSelectAll}" InputGesture="Ctrl+A"/>
                <Separator/>
                <MenuItem Header="_Find…" Command="{Binding CmdFind}" InputGesture="Ctrl+F">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Find}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="R_eplace…" Command="{Binding CmdReplace}" InputGesture="Ctrl+H"/>
                <MenuItem Header="Find _next" Command="{Binding CmdFindNext}" InputGesture="F3"/>
                <MenuItem Header="Find pre_vious" Command="{Binding CmdFindPrevious}" InputGesture="Shift+F3"/>
                <MenuItem Header="_Go to line…" Command="{Binding CmdGoToLine}" InputGesture="Ctrl+G"/>
                <Separator/>
                <MenuItem Header="Complete _word" Command="{Binding CmdComplete}" InputGesture="Ctrl+Space"/>
                <MenuItem Header="C_omment selection" Command="{Binding CmdComment}" InputGesture="Ctrl+K">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Comment}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Uncomment selection" Command="{Binding CmdUncomment}" InputGesture="Ctrl+Shift+K"/>
                <MenuItem Header="Re_indent selection" Command="{Binding CmdReindent}" InputGesture="Ctrl+I"/>
                <Separator/>
                <!-- Two-key shortcuts (chords) cannot be shown as a gesture: they are in the header. -->
                <MenuItem x:Name="FoldAllItem" Header="Fold a_ll   (Ctrl+M, Ctrl+O)" Command="{Binding CmdFoldAll}"/>
                <MenuItem x:Name="UnfoldAllItem" Header="Unfol_d all   (Ctrl+M, Ctrl+L)" Command="{Binding CmdUnfoldAll}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ShowExplorerItem" Header="_Explorer" ToggleType="CheckBox" Click="OnTogglePanels"/>
                <MenuItem x:Name="ShowOutlineItem" Header="_Outline" ToggleType="CheckBox" Click="OnTogglePanels"/>
                <MenuItem x:Name="ShowBottomItem" Header="_Bottom panel" ToggleType="CheckBox" Click="OnTogglePanels"/>
                <Separator/>
                <MenuItem Header="O_utput" Command="{Binding CmdShowPanel}" CommandParameter="output" InputGesture="Ctrl+Alt+O"/>
                <MenuItem Header="Error _list" Command="{Binding CmdShowPanel}" CommandParameter="errors" InputGesture="Ctrl+Alt+E"/>
                <MenuItem Header="_Console" Command="{Binding CmdShowPanel}" CommandParameter="console" InputGesture="Ctrl+Alt+C"/>
                <MenuItem Header="Call _stack" Command="{Binding CmdShowPanel}" CommandParameter="stack" InputGesture="Ctrl+Alt+P"/>
                <MenuItem Header="_Variables" Command="{Binding CmdShowPanel}" CommandParameter="variables" InputGesture="Ctrl+Alt+V"/>
                <Separator/>
                <MenuItem Header="_Zoom in" Command="{Binding CmdZoomIn}" InputGesture="Ctrl+OemPlus"/>
                <MenuItem Header="Zoom ou_t" Command="{Binding CmdZoomOut}" InputGesture="Ctrl+OemMinus"/>
                <MenuItem Header="_Normal size" Command="{Binding CmdZoomReset}" InputGesture="Ctrl+D0"/>
                <Separator/>
                <MenuItem x:Name="WordWrapItem" Header="_Word wrap" ToggleType="CheckBox" Click="OnEditorOptionChanged"/>
                <MenuItem x:Name="LineNumbersItem" Header="Line _numbers" ToggleType="CheckBox" Click="OnEditorOptionChanged"/>
                <MenuItem x:Name="WhitespaceItem" Header="Show w_hitespace" ToggleType="CheckBox" Click="OnEditorOptionChanged"/>
                <Separator/>
                <MenuItem Header="_Theme">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Theme}"/></MenuItem.Icon>
                    <MenuItem x:Name="ThemeLightItem" Header="_Light" ToggleType="CheckBox" Click="OnThemeLight"/>
                    <MenuItem x:Name="ThemeDarkItem" Header="_Dark" ToggleType="CheckBox" Click="OnThemeDark"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Build">
                <MenuItem Header="_Build" Command="{Binding CmdBuild}" InputGesture="F7">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Build}" Fill="{DynamicResource Brush.IconOrange}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="GenerateExeItem" Header="_Generate standalone .exe…" Command="{Binding CmdGenerateExe}" InputGesture="Ctrl+Shift+E">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Package}" Fill="{DynamicResource Brush.IconPurple}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="LanguageMenu" Header="File _language" SubmenuOpened="OnLanguageMenuOpened">
                    <MenuItem Header="(no file)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="BackgroundCheckItem" Header="Background _checking" ToggleType="CheckBox" Click="OnBuildOptionChanged"/>
                <MenuItem x:Name="DebugInfoItem" Header="_Debug information in .exe files" ToggleType="CheckBox" Click="OnBuildOptionChanged"/>
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem x:Name="DebugMenuItem" Header="_Start debugging" Command="{Binding CmdDebug}" InputGesture="F5">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.IconGreen}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Run without debugging" Command="{Binding CmdRun}" InputGesture="Ctrl+F5">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.PlayOutline}" Fill="{DynamicResource Brush.IconGreen}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="S_top" Command="{Binding CmdStop}" InputGesture="Shift+F5">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Stop}" Fill="{DynamicResource Brush.IconRed}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="R_estart" Command="{Binding CmdRestart}" InputGesture="Ctrl+Shift+F5"/>
                <MenuItem Header="_Pause" Command="{Binding CmdPause}" InputGesture="Ctrl+Alt+Pause">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Pause}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Step _into" Command="{Binding CmdStepInto}" InputGesture="F11">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.StepInto}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step _over" Command="{Binding CmdStepOver}" InputGesture="F10">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.StepOver}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step o_ut" Command="{Binding CmdStepOut}" InputGesture="Shift+F11">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.StepOut}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Toggle _breakpoint" Command="{Binding CmdToggleBreakpoint}" InputGesture="F9">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Breakpoint}" Fill="{DynamicResource Brush.IconRed}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Delete all breakpoints" Command="{Binding CmdClearBreakpoints}" InputGesture="Ctrl+Shift+F9"/>
                <Separator/>
                <MenuItem x:Name="StopOnEntryItem" Header="Stop at _first statement" ToggleType="CheckBox" Click="OnDebugOptionChanged"/>
                <MenuItem x:Name="BreakOnErrorItem" Header="Break on runtime _error" ToggleType="CheckBox" Click="OnDebugOptionChanged"/>
                <MenuItem x:Name="ExternalConsoleItem" Header="Run in e_xternal Windows console" ToggleType="CheckBox" Click="OnDebugOptionChanged"/>
            </MenuItem>
            <MenuItem x:Name="ExamplesMenu" Header="E_xamples" SubmenuOpened="OnExamplesMenuOpened">
                <MenuItem Header="(no examples found)" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Simula 67 help" Command="{Binding CmdHelp}" CommandParameter="simula">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconBlue}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Algol 68 help" Command="{Binding CmdHelp}" CommandParameter="algol68">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconGreen}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Algol 6_0 help" Command="{Binding CmdHelp}" CommandParameter="algol60">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconOrange}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Simula _I help" Command="{Binding CmdHelp}" CommandParameter="simula1">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconRed}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Pascal help" Command="{Binding CmdHelp}" CommandParameter="pascal">
                    <MenuItem.Icon><Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconPurple}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Help for the _current file's language" Command="{Binding CmdHelp}" InputGesture="F1"/>
                <MenuItem Header="_Keyboard shortcuts" Command="{Binding CmdHelp}" CommandParameter="shortcuts"/>
                <Separator/>
                <MenuItem Header="_About AlgolStudio" Command="{Binding CmdAbout}"/>
            </MenuItem>
        </Menu>

        <!-- ============================== Toolbar ============================== -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,3">
            <StackPanel Orientation="Horizontal">
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdNewSimula}" ToolTip.Tip="New Simula 67 program (Ctrl+N)">
                    <Grid>
                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconBlue}"/>
                        <TextBlock Text="S" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.IconBlue}" Margin="6,6,0,0"/>
                    </Grid>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdNewAlgol}" ToolTip.Tip="New Algol 68 program (Ctrl+Shift+N)">
                    <Grid>
                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.New}" Fill="{DynamicResource Brush.IconGreen}"/>
                        <TextBlock Text="A" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.IconGreen}" Margin="6,6,0,0"/>
                    </Grid>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdOpen}" ToolTip.Tip="Open (Ctrl+O)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Fill="{DynamicResource Brush.IconYellow}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdSave}" ToolTip.Tip="Save (Ctrl+S)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdSaveAll}" ToolTip.Tip="Save all (Ctrl+Shift+S)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.SaveAll}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Border Width="1" Margin="5,2" Background="{DynamicResource Brush.Border}"/>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdUndo}" ToolTip.Tip="Undo (Ctrl+Z)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdRedo}" ToolTip.Tip="Redo (Ctrl+Y)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdFind}" ToolTip.Tip="Find / replace (Ctrl+F, Ctrl+H)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Find}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdToggleComment}" ToolTip.Tip="Comment / uncomment (Ctrl+K)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Comment}"/>
                </Button>
                <Border Width="1" Margin="5,2" Background="{DynamicResource Brush.Border}"/>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdBuild}" ToolTip.Tip="Build (F7)">
                    <StackPanel Orientation="Horizontal">
                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Build}" Fill="{DynamicResource Brush.IconOrange}"/>
                        <TextBlock Text="Build" Margin="4,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdDebug}" ToolTip.Tip="Start debugging / Continue (F5)">
                    <StackPanel Orientation="Horizontal">
                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.IconGreen}"/>
                        <TextBlock x:Name="DebugButtonText" Text="Debug" Margin="4,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdRun}" ToolTip.Tip="Run without debugging (Ctrl+F5)">
                    <StackPanel Orientation="Horizontal">
                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.PlayOutline}" Fill="{DynamicResource Brush.IconGreen}"/>
                        <TextBlock Text="Run" Margin="4,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdPause}" ToolTip.Tip="Pause (Ctrl+Alt+Pause)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Pause}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdStop}" ToolTip.Tip="Stop (Shift+F5)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Stop}" Fill="{DynamicResource Brush.IconRed}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdStepInto}" ToolTip.Tip="Step into (F11)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.StepInto}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdStepOver}" ToolTip.Tip="Step over (F10)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.StepOver}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdStepOut}" ToolTip.Tip="Step out (Shift+F11)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.StepOut}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdToggleBreakpoint}" ToolTip.Tip="Toggle breakpoint (F9)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Breakpoint}" Fill="{DynamicResource Brush.IconRed}"/>
                </Button>
                <Border Width="1" Margin="5,2" Background="{DynamicResource Brush.Border}"/>
                <Button x:Name="GenerateExeButton" Theme="{StaticResource ToolButton}" Command="{Binding CmdGenerateExe}" ToolTip.Tip="Generate standalone .exe (Ctrl+Shift+E)">
                    <StackPanel Orientation="Horizontal">
                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Package}" Fill="{DynamicResource Brush.IconPurple}"/>
                        <TextBlock x:Name="GenerateExeText" Text=".exe" Margin="4,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="ExternalConsoleToggle" Theme="{StaticResource ToolToggle}" Click="OnExternalConsoleToggle"
                              ToolTip.Tip="Run in an external Windows console">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Console}"/>
                </ToggleButton>
                <Border Width="1" Margin="5,2" Background="{DynamicResource Brush.Border}"/>
                <Button Theme="{StaticResource ToolButton}" Command="{Binding CmdHelp}" ToolTip.Tip="Help (F1)">
                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Help}" Fill="{DynamicResource Brush.IconBlue}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================== Status bar ============================== -->
        <Border x:Name="StatusBarBorder" DockPanel.Dock="Bottom" Background="{DynamicResource Brush.StatusBar}" Padding="8,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="StatusPosition" Foreground="{DynamicResource Brush.StatusBarText}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusInsert" Foreground="{DynamicResource Brush.StatusBarText}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusEncoding" Foreground="{DynamicResource Brush.StatusBarText}" Margin="12,0" VerticalAlignment="Center"/>
                    <Button x:Name="StatusLanguage" Theme="{StaticResource ToolButton}" Padding="6,0" Click="OnStatusLanguageClick"
                            ToolTip.Tip="File language (click to change)">
                        <TextBlock x:Name="StatusLanguageText" Foreground="{DynamicResource Brush.StatusBarText}" FontWeight="SemiBold"/>
                    </Button>
                    <TextBlock x:Name="StatusZoom" Foreground="{DynamicResource Brush.StatusBarText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusState" DockPanel.Dock="Left" Foreground="{DynamicResource Brush.StatusBarText}" FontWeight="SemiBold" VerticalAlignment="Center" Text="Ready"/>
                <TextBlock x:Name="StatusMessage" Foreground="{DynamicResource Brush.StatusBarText}" Margin="16,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ============================== Main area ============================== -->
        <!-- Rows: editors, bottom splitter, bottom panel. Columns: explorer, splitter, editors, splitter, outline. -->
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Explorer -->
            <DockPanel x:Name="ExplorerPanel" Grid.Column="0" Background="{DynamicResource Brush.PanelBackground}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelHeader}" Height="28"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="OpenFolderButton" Theme="{StaticResource ToolButton}" Padding="3" Command="{Binding CmdOpenFolder}" ToolTip.Tip="Open folder…">
                                <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Fill="{DynamicResource Brush.IconYellow}"/>
                            </Button>
                            <Button Theme="{StaticResource ToolButton}" Padding="3" Click="OnExplorerRefresh" ToolTip.Tip="Refresh">
                                <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}"/>
                            </Button>
                            <Button Theme="{StaticResource ToolButton}" Padding="3" Click="OnExplorerCollapse" ToolTip.Tip="Collapse all">
                                <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Collapse}"/>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="ExplorerTitle" Text="EXPLORER" Theme="{StaticResource PanelHeaderText}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <TreeView x:Name="ExplorerTree" DoubleTapped="OnExplorerDoubleClick" KeyDown="OnExplorerKeyDown">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="ToolTip.Tip" Value="{Binding FullPath}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="OnExplorerOpen"/>
                            <MenuItem x:Name="ExplorerRevealItem" Header="Show in the file manager" Click="OnExplorerReveal"/>
                            <Separator/>
                            <MenuItem Header="Refresh" Click="OnExplorerRefresh"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Grid Width="16" Height="16">
                                    <Path Theme="{StaticResource IconPath}" Data="{Binding Icon}" Fill="{Binding IconBrush}"/>
                                    <TextBlock Text="{Binding Badge}" FontSize="7.5" FontWeight="Bold" Foreground="{Binding IconBrush}"
                                               Margin="6,6,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- Editors -->
            <Grid Grid.Column="2">
                <TabControl x:Name="DocTabs" Theme="{StaticResource DocTabControl}" SelectionChanged="OnDocTabChanged"/>
                <ScrollViewer x:Name="WelcomePanel" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Welcome}">
                    <StackPanel Margin="48,36" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/app256.png" Width="64" Height="64"/>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AlgolStudio" FontSize="26" FontWeight="Light"/>
                                <TextBlock Text="A development environment for great historic languages: Simula 67, Algol 68, Algol 60, Simula I and Pascal"
                                           Foreground="{DynamicResource Brush.TextDim}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,28,0,0" ColumnDefinitions="*,*">
                            <StackPanel>
                                <TextBlock Text="Start" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdNewSimula}" Content="New Simula 67 program"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdNewAlgol}" Content="New Algol 68 program"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdNewAlgol60}" Content="New Algol 60 program"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdNewSimulaI}" Content="New Simula I program"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdNewPascal}" Content="New Pascal program"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdOpen}" Content="Open a file…"/>
                                <Button x:Name="OpenFolderLink" Theme="{StaticResource LinkButton}" Command="{Binding CmdOpenFolder}" Content="Open a folder…"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="simula" Content="Simula 67 help"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="algol68" Content="Algol 68 help"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="algol60" Content="Algol 60 help"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="simula1" Content="Simula I help"/>
                                <Button Theme="{StaticResource LinkButton}" Command="{Binding CmdHelp}" CommandParameter="pascal" Content="Pascal help"/>
                                <TextBlock Text="Recent files" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
                                <ItemsControl x:Name="WelcomeRecent">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Theme="{StaticResource LinkButton}" Click="OnWelcomeRecentClick" Tag="{Binding}" ToolTip.Tip="{Binding}">
                                                <TextBlock Text="{Binding Converter={x:Static panels:FileNameConverter.Instance}}"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="WelcomeNoRecent" Text="(none)" Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                <TextBlock Text="Examples" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="WelcomeSamples">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Theme="{StaticResource LinkButton}" Click="OnWelcomeRecentClick" Tag="{Binding}" ToolTip.Tip="{Binding}">
                                                <TextBlock Text="{Binding Converter={x:Static panels:SampleNameConverter.Instance}}"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="WelcomeNoSamples" Text="(samples folder not found)" Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="WelcomeShortcuts" Margin="0,28,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}"
                                   Text="Shortcuts: F7 build · F5 debug · Ctrl+F5 run · F9 breakpoint · F10/F11 step · Ctrl+Space complete · Ctrl+F find · F1 help. Drag and drop files onto the window to open them."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- Outline -->
            <DockPanel x:Name="OutlinePanel" Grid.Column="4" Background="{DynamicResource Brush.PanelBackground}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelHeader}" Height="28"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="OutlineTitle" Text="OUTLINE" Theme="{StaticResource PanelHeaderText}" TextTrimming="CharacterEllipsis"/>
                </Border>
                <TextBox x:Name="OutlineFilter" DockPanel.Dock="Top" Margin="4" TextChanged="OnOutlineFilterChanged"
                         ToolTip.Tip="Filter the outline"/>
                <TextBlock x:Name="OutlineEmpty" DockPanel.Dock="Top" Margin="10,6" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}"
                           Text="No procedure, class, operator or mode."/>
                <ListBox x:Name="OutlineList" SelectionMode="Single" Tapped="OnOutlineClick" KeyDown="OnOutlineKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip.Tip="{Binding ToolTipText}">
                                <Border Width="16" Height="16" CornerRadius="3" Background="{Binding Badge}">
                                    <TextBlock Text="{Binding Letter}" Foreground="White" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Detail}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextDim}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Grid.ColumnSpan="5" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

            <!-- ============================== Bottom panel ============================== -->
            <TabControl x:Name="BottomTabs" Grid.Row="2" Grid.ColumnSpan="5" Theme="{StaticResource PanelTabControl}"
                        ItemContainerTheme="{StaticResource PanelTabItem}">
                <TabItem x:Name="OutputTab" Header="Output">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,2">
                            <StackPanel Orientation="Horizontal">
                                <Button Theme="{StaticResource ToolButton}" Click="OnClearOutput" ToolTip.Tip="Clear the output">
                                    <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Clear}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <ae:TextEditor x:Name="OutputBox" IsReadOnly="True" FontFamily="{StaticResource CodeFont}" FontSize="12.5"
                                       ShowLineNumbers="False" WordWrap="False" Padding="4,2"
                                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                       Background="{DynamicResource Brush.EditorBackground}" Foreground="{DynamicResource Brush.Text}"
                                       DoubleTapped="OnOutputDoubleClick"
                                       ToolTip.Tip="Double-click a diagnostic to go to its line"/>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="ErrorsTab">
                    <TabItem.Header>
                        <TextBlock x:Name="ErrorsTabHeader" Text="Errors"/>
                    </TabItem.Header>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,2">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="FilterErrors" Theme="{StaticResource ToolToggle}" IsChecked="True" Click="OnErrorFilterChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.ErrorMark}" Fill="{DynamicResource Brush.Error}"/>
                                        <TextBlock x:Name="FilterErrorsText" Text="0 errors" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="FilterWarnings" Theme="{StaticResource ToolToggle}" IsChecked="True" Click="OnErrorFilterChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.WarningMark}" Fill="{DynamicResource Brush.Warning}"/>
                                        <TextBlock x:Name="FilterWarningsText" Text="0 warnings" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="FilterInfos" Theme="{StaticResource ToolToggle}" IsChecked="True" Click="OnErrorFilterChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.InfoMark}" Fill="{DynamicResource Brush.Info}"/>
                                        <TextBlock x:Name="FilterInfosText" Text="0 messages" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="ErrorList" DoubleTapped="OnErrorDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="28" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Path Theme="{StaticResource IconPath}" Data="{Binding Icon}" Fill="{Binding IconBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Description" Width="620">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}"
                                                       VerticalAlignment="Center" Margin="6,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="File" Width="160" Binding="{Binding FileName}"/>
                                <DataGridTextColumn Header="Line" Width="55" Binding="{Binding LineText}"/>
                                <DataGridTextColumn Header="Col." Width="45" Binding="{Binding ColumnText}"/>
                                <DataGridTextColumn Header="Origin" Width="90" Binding="{Binding Origin}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="ConsoleTab" Header="Console">
                    <panels:ConsolePanel x:Name="ConsoleView"/>
                </TabItem>
                <TabItem x:Name="StackTab" Header="Call stack">
                    <Grid>
                        <DataGrid x:Name="StackList" DoubleTapped="OnStackDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="26" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Arrow}" Fill="{Binding MarkerBrush}"
                                                  IsVisible="{Binding IsSelectedFrame}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Procedure / block" Width="300" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="File" Width="200" Binding="{Binding FileName}"/>
                                <DataGridTextColumn Header="Line" Width="60" Binding="{Binding LineText}"/>
                                <DataGridTextColumn Header="Col." Width="50" Binding="{Binding ColumnText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="StackEmpty" Margin="10,34,10,10" Foreground="{DynamicResource Brush.TextDim}"
                                   Text="The call stack is shown when the program is paused in the debugger."/>
                    </Grid>
                </TabItem>
                <TabItem x:Name="VariablesTab" Header="Variables">
                    <Grid>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelHeader}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,0,0,1" Padding="8,3">
                                <TextBlock x:Name="VariablesHeader" Foreground="{DynamicResource Brush.TextDim}" Text="Name = value   (type)"/>
                            </Border>
                            <TreeView x:Name="VariablesTree" FontFamily="{StaticResource CodeFont}">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text=" = " Foreground="{DynamicResource Brush.TextDim}"/>
                                            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="{Binding TypeSuffix}" Foreground="{DynamicResource Brush.TextDim}"/>
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                        <TextBlock x:Name="VariablesEmpty" Margin="10,34,10,10" Foreground="{DynamicResource Brush.TextDim}"
                                   Text="Variables are shown when the program is paused in the debugger."/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
