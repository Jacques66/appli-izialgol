<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#1F2023"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#25262A"/>
    <SolidColorBrush x:Key="Brush.PanelHeader" Color="#2D2F34"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#3C3F45"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#DCDFE4"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="#8B919B"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#3B8EEA"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#34373D"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#3F434B"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#264F78"/>
    <SolidColorBrush x:Key="Brush.SelectionInactive" Color="#37393F"/>
    <SolidColorBrush x:Key="Brush.MenuBackground" Color="#2A2C30"/>
    <SolidColorBrush x:Key="Brush.MenuBorder" Color="#45484F"/>
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#1B1C1F"/>
    <SolidColorBrush x:Key="Brush.EditorBackground" Color="#1E1F22"/>
    <SolidColorBrush x:Key="Brush.StatusBar" Color="#0F5FA8"/>
    <SolidColorBrush x:Key="Brush.StatusBarRunning" Color="#B24D00"/>
    <SolidColorBrush x:Key="Brush.StatusBarPaused" Color="#7A2A99"/>
    <SolidColorBrush x:Key="Brush.StatusBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TabActive" Color="#1E1F22"/>
    <SolidColorBrush x:Key="Brush.TabInactive" Color="#2D2F34"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#4A4E56"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#666B75"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#F05454"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#E8B339"/>
    <SolidColorBrush x:Key="Brush.Info" Color="#4FA3F7"/>
    <SolidColorBrush x:Key="Brush.IconGreen" Color="#5BC46E"/>
    <SolidColorBrush x:Key="Brush.IconRed" Color="#F05454"/>
    <SolidColorBrush x:Key="Brush.IconBlue" Color="#5EA4EE"/>
    <SolidColorBrush x:Key="Brush.IconYellow" Color="#E8B339"/>
    <SolidColorBrush x:Key="Brush.IconGray" Color="#B0B5BD"/>
    <SolidColorBrush x:Key="Brush.IconPurple" Color="#B98AE8"/>
    <SolidColorBrush x:Key="Brush.IconOrange" Color="#EE9A4D"/>
    <SolidColorBrush x:Key="Brush.Welcome" Color="#1E1F22"/>
    <SolidColorBrush x:Key="Brush.Link" Color="#5EA4EE"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F78"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#37393F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#DCDFE4"/>
</ResourceDictionary>
