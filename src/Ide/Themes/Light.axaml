<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#EEF0F4"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="Brush.PanelHeader" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#CDD2DA"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="#6B7280"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#0063B1"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#DCE6F4"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#C3D5EE"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#CCE0F7"/>
    <SolidColorBrush x:Key="Brush.SelectionInactive" Color="#E1E6EE"/>
    <SolidColorBrush x:Key="Brush.MenuBackground" Color="#FBFBFC"/>
    <SolidColorBrush x:Key="Brush.MenuBorder" Color="#C5CAD3"/>
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.EditorBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.StatusBar" Color="#0063B1"/>
    <SolidColorBrush x:Key="Brush.StatusBarRunning" Color="#C25400"/>
    <SolidColorBrush x:Key="Brush.StatusBarPaused" Color="#8E2BAD"/>
    <SolidColorBrush x:Key="Brush.StatusBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TabActive" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TabInactive" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#B9BFC9"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#8E96A3"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#D32F2F"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#D99A00"/>
    <SolidColorBrush x:Key="Brush.Info" Color="#1E88E5"/>
    <SolidColorBrush x:Key="Brush.IconGreen" Color="#2E9E44"/>
    <SolidColorBrush x:Key="Brush.IconRed" Color="#D32F2F"/>
    <SolidColorBrush x:Key="Brush.IconBlue" Color="#1F6FB7"/>
    <SolidColorBrush x:Key="Brush.IconYellow" Color="#D9A520"/>
    <SolidColorBrush x:Key="Brush.IconGray" Color="#5F6670"/>
    <SolidColorBrush x:Key="Brush.IconPurple" Color="#7B3FB5"/>
    <SolidColorBrush x:Key="Brush.IconOrange" Color="#D9822B"/>
    <SolidColorBrush x:Key="Brush.Welcome" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Link" Color="#0063B1"/>
</ResourceDictionary>
