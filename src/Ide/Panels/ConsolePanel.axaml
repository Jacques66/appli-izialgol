<UserControl x:Class="Studio.Ide.Panels.ConsolePanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit">
    <DockPanel Background="{DynamicResource Brush.PanelBackground}">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,2">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Theme="{StaticResource ToolButton}" Click="OnClear" ToolTip.Tip="Clear the console">
                        <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Clear}"/>
                    </Button>
                    <Button x:Name="EofButton" Theme="{StaticResource ToolButton}" Click="OnEof" IsEnabled="False"
                            ToolTip.Tip="Send end-of-file to the program (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal">
                            <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Eof}" Fill="{DynamicResource Brush.IconBlue}"/>
                            <TextBlock Text="End of file" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Theme="{StaticResource ToolButton}" Click="OnStop" IsEnabled="False"
                            ToolTip.Tip="Stop the program (Shift+F5)">
                        <StackPanel Orientation="Horizontal">
                            <Path Theme="{StaticResource IconPath}" Data="{StaticResource Icon.Stop}" Fill="{DynamicResource Brush.IconRed}"/>
                            <TextBlock Text="Stop" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="ClearOnRunBox" Content="Clear on each run" VerticalAlignment="Center" Margin="10,0,0,0"
                              IsCheckedChanged="OnClearOnRunChanged"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0"
                           Foreground="{DynamicResource Brush.TextDim}"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="4,3">
            <DockPanel>
                <TextBlock x:Name="Prompt" DockPanel.Dock="Left" Text="›" FontFamily="{StaticResource CodeFont}" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{DynamicResource Brush.TextDim}"/>
                <Button DockPanel.Dock="Right" x:Name="SendButton" Theme="{StaticResource DialogButton}" Content="Send"
                        Click="OnSend" IsEnabled="False" MinWidth="70" Padding="8,2"/>
                <TextBox x:Name="Input" FontFamily="{StaticResource CodeFont}" IsEnabled="False"
                         ToolTip.Tip="Program input: Enter = send line, Ctrl+Z = end of file, ↑/↓ = history"/>
            </DockPanel>
        </Border>
        <ae:TextEditor x:Name="Output" IsReadOnly="True" WordWrap="True" ShowLineNumbers="False"
                       FontFamily="{StaticResource CodeFont}" FontSize="13" Padding="6,2"
                       HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</UserControl>
