<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Simula67Studio</AssemblyName>
    <RootNamespace>Studio.Ide</RootNamespace>
    <Product>Simula 67 &amp; Algol 68 Studio</Product>
    <AssemblyTitle>Simula 67 &amp; Algol 68 Studio</AssemblyTitle>
    <Version>1.0.0</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Runner is referenced only for the build order (no assembly reference). -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="0.38.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Simula\Simula.csproj" />
    <ProjectReference Include="..\Algol68\Algol68.csproj" />
    <!-- Single-file Runner.exe (bin\...\single) for "Generate .exe" and the external console. -->
    <ProjectReference Include="..\Runner\Runner.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Runner\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app256.png" />
  </ItemGroup>

</Project>
