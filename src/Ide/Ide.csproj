<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform IDE user interface (Avalonia): views, view models, editor, panels, dialogs, services.
    The platform heads (src/Ide.Desktop today, a browser head later) start it and provide IPlatformServices.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AlgolStudio.Ide</AssemblyName>
    <RootNamespace>Studio.Ide</RootNamespace>
    <Product>AlgolStudio</Product>
    <AssemblyTitle>AlgolStudio</AssemblyTitle>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="Markdig" Version="0.38.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Simula\Simula.csproj" />
    <ProjectReference Include="..\Algol68\Algol68.csproj" />
    <ProjectReference Include="..\Algol60\Algol60.csproj" />
    <ProjectReference Include="..\SimulaI\SimulaI.csproj" />
    <ProjectReference Include="..\Pascal\Pascal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Runner\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\app256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The desktop head (assembly AlgolStudio) runs the self-test, which inspects the main window. -->
    <InternalsVisibleTo Include="AlgolStudio" />
  </ItemGroup>

</Project>
