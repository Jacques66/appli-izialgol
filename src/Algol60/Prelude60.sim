begin
   comment ==================================================================
           Environmental block of Algol 60 (Modified Report, 1976, appendix 2).
           Written in Simula syntax: transmission modes follow the Simula rules
           (the name parts are explicit).
           Identifiers ending in __ are internal.
           ==================================================================;

   comment --- simple functions (compiled inline when called);
   real procedure abs(E); value E; real E; abs := abs(E);
   integer procedure iabs(E); value E; integer E; iabs := if E >= 0 then E else -E;
   integer procedure sign(E); value E; real E; sign := sign(E);
   integer procedure entier(E); value E; real E; entier := entier(E);

   comment --- mathematical functions;
   real procedure sqrt(E); value E; real E;
      if E < 0.0 then __a60_fault("negative sqrt", E) else sqrt := sqrt(E);
   real procedure sin(E); value E; real E; sin := sin(E);
   real procedure cos(E); value E; real E; cos := cos(E);
   real procedure arctan(E); value E; real E; arctan := arctan(E);
   real procedure ln(E); value E; real E;
      if E <= 0.0 then __a60_fault("ln not positive", E) else ln := ln(E);
   real procedure exp(E); value E; real E;
      if E > 709.782712893384 then __a60_fault("overflow on exp", E) else exp := exp(E);

   comment --- terminating procedures;
   procedure stop; goto stop_;
   procedure fault(str, r); value r; text str; real r; __a60_fault(str, r);

   comment --- input/output procedures (every channel is the console);
   procedure inchar(channel, str, int); value channel; name int; integer channel, int; text str;
   begin integer c;
      c := __a60_inchar(channel);
      int := if c < 0 then 0 else __a60_index(str, c)
   end inchar;

   procedure outchar(channel, str, int); value channel, int; integer channel, int; text str;
      if int < 1 or int > str.length then __a60_fault("character not in string", int)
      else __a60_out(channel, str.sub(int, 1));

   integer procedure length(str); text str; length := str.length;

   procedure outstring(channel, str); value channel; integer channel; text str;
      __a60_out(channel, str);

   procedure outterminator(channel); value channel; integer channel;
      __a60_out(channel, " ");

   procedure ininteger(channel, int); value channel; name int; integer channel, int;
      int := __a60_readint(channel);

   procedure outinteger(channel, int); value channel, int; integer channel, int;
   begin
      procedure digits(int); value int; integer int;
      begin integer j;
         comment use recursion to evaluate digits from right to left,
                 but print them from left to right;
         j := int // 10;
         int := int - 10 * j;
         if j <> 0 then digits(j);
         outchar(channel, "0123456789", int + 1)
      end digits;
      if int < 0 then
      begin
         outchar(channel, "-", 1);
         if int = minint__ then
         begin outstring(channel, "2147483648"); outterminator(channel); goto done__ end;
         int := -int
      end;
      digits(int);
      outterminator(channel);
   done__:
   end outinteger;

   procedure inreal(channel, re); value channel; name re; integer channel; real re;
      re := __a60_readreal(channel);

   procedure outreal(channel, re); value channel, re; integer channel; real re;
   begin
      if re < 0.0 then
      begin
         outchar(channel, "-", 1);
         re := - re
      end;
      if re < minreal then
         outstring(channel, "0.0 ")
      else
         outstring(channel, __a60_realtext(re))
   end outreal;

   comment --- environmental enquiries;
   integer minint__;
   real procedure maxreal; maxreal := 1.7976931348623157&308;
   real procedure minreal; minreal := 2.2250738585072014&-308;
   integer procedure maxint; maxint := 2147483647;
   real procedure epsilon; epsilon := 2.220446049250313&-16;

   minint__ := -2147483647 - 1;
   __program__;
stop_:
end
