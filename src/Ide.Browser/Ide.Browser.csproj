<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    Browser head of the IDE (WebAssembly): the same Avalonia user interface (src/Ide) in a web page.
    It needs the wasm-tools workload (dotnet workload install wasm-tools), so it is not part of AlgolStudio.sln:
      dotnet publish src/Ide.Browser/Ide.Browser.csproj -c Release -o out/browser
    The site is out/browser/wwwroot (see README.md and .github/workflows/pages.yml).

    The compilers and their runtimes use threads (program thread, debugger pauses, Algol 68 PAR, console
    input that waits), hence WasmEnableThreads: the page must be cross-origin isolated (COOP/COEP headers,
    set by wwwroot/coi-serviceworker.js on hosts such as GitHub Pages that cannot send headers).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AlgolStudio.Browser</AssemblyName>
    <RootNamespace>Studio.Ide.Browser</RootNamespace>
    <Product>AlgolStudio</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <WasmEnableThreads>true</WasmEnableThreads>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No precompressed .br/.gz copies: GitHub Pages compresses the files itself. -->
    <CompressionEnabled>false</CompressionEnabled>
    <!-- Readable exception messages (the runtime errors of the programs show them). -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- The settings and the persisted files are (de)serialized by reflection. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Trimming: only the framework assemblies; the IDE, the compilers and Avalonia are kept whole
         (reflection bindings, XAML, settings). -->
    <TrimMode>partial</TrimMode>
    <!-- ThreadedRuntime.cs replaces the Avalonia dispatcher (IDispatcherImpl, a private API of Avalonia 11.3.22). -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);AVA3001</MSBuildWarningsAsMessages>
    <!-- Thread, Monitor.Wait… are reported as unsupported on 'browser': they are supported with WasmEnableThreads. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ide\Ide.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="AlgolStudio.Ide" />
    <TrimmerRootAssembly Include="Common" />
    <TrimmerRootAssembly Include="Simula" />
    <TrimmerRootAssembly Include="Algol68" />
    <TrimmerRootAssembly Include="Algol60" />
    <TrimmerRootAssembly Include="SimulaI" />
    <TrimmerRootAssembly Include="Pascal" />
  </ItemGroup>

  <ItemGroup>
    <!-- Monospace font of the editor and the console (the browser has no system fonts). -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- Examples and documentation, copied into the virtual file system at start-up (VirtualFiles.cs). -->
    <EmbeddedResource Include="..\..\samples\**\*" LogicalName="samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\*.md" LogicalName="docs/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
