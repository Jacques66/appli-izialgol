<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Simula\Simula.csproj" />
    <ProjectReference Include="..\Algol68\Algol68.csproj" />
    <!-- Garantit que Runner.exe (mono-fichier) est construit pour l'option -o. -->
    <ProjectReference Include="..\Runner\Runner.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Runner\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>simc</AssemblyName>
    <RootNamespace>Studio.SimC</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <Product>Simula 67 &amp; Algol 68 Studio</Product>
    <!-- Runner est reference uniquement pour l'ordre de construction (pas d'assembly). -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

</Project>
