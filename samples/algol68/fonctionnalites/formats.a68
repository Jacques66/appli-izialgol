# Transput formate : motifs entiers, reels, booleens, chaines, bits, choix, general, collections #
BEGIN
   printf(($"Bonjour"l$));
   printf(($"n = "g(0)l$, 42));
   printf(($5d l$, 42));
   printf(($5zd l$, 42));
   printf(($-4zd l$, -42));
   printf(($+4zd l$, 42));
   printf(($-d.3d l$, 3.14159));
   printf(($+d.3de+2d l$, 1250.0));
   printf(($3d"/"2d"/"4d l$, 21));
   printf(($2d"/", 2d"/", 4d l$, 21, 10, 2026));
   printf(($zd"h", 2d l$, 9, 5));
   printf(($c("lundi","mardi","mercredi")l$, 2));
   printf(($b x, b("oui","non")l$, TRUE, FALSE));
   printf(($5a"|"l$, "abcde"));
   printf(($2r8d l$, BIN 10));
   printf(($16r3zd l$, BIN 255));
   INT w = 7;
   printf(($n(w)d l$, 123));
   printf(($3(d" ")l$, 1, 2, 3));
   printf(($g(8, 2)l$, 3.14159));
   printf(($g(-8, 2)l$, 3.14159));
   FORMAT f = $"x="g(0)$;
   printf((f, 5, newline));
   printf(($g(0)" "$, 1, 2, 3)); print(newline);
   FORMAT entier = $g(0)$;
   printf(($"["f(entier)"]"l$, 7));
   printf(($"a"3x"b"l$));
   printf(($d.1di d.1d l$, 1.5 I 2.5));
   printf(($l"ligne"$));
   printf(($l$));
   [] INT t = (10, 20, 30);
   printf(($"t :"n(UPB t)(x2d)l$, t));
   printf(($g(0, 3)l$, 2/3));
   printf(($g(12, 3, 2)l$, 123456.789))
END
