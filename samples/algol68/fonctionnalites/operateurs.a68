# Operateurs : declarations, priorites, surcharge, operateurs symboliques et gras #
BEGIN
   PRIO MAX = 9, MIN = 9;
   OP MAX = (INT a, b) INT: (a > b | a | b);
   OP MAX = (REAL a, b) REAL: (a > b | a | b);
   OP MIN = (INT a, b) INT: (a < b | a | b);
   print((3 MAX 7, 2.5 MAX 1.5, 4 MIN 9, newline));
   print((1 + 2 MAX 5, newline));
   PRIO <> = 4;
   OP <> = (INT a, b) BOOL: a /= b;
   OP ? = (INT a) INT: a * a;
   print((3 <> 4, 3 <> 3, ? 5 + 1, newline));
   OP DOUBLE = (INT a) INT: 2 * a;
   PRIO DOUBLE = 7;
   OP DOUBLE = (INT a, b) INT: 2 * (a + b);
   print((DOUBLE 4, 3 DOUBLE 4, newline));
   BEGIN
      OP + = (INT a, b) INT: a * b;
      print((2 + 3, newline))
   END;
   print((2 + 3, newline));
   MODE FRAC = STRUCT (INT num, den);
   PROC pgcd = (INT a, b) INT: (b = 0 | ABS a | pgcd(b, a MOD b));
   OP NORM = (FRAC f) FRAC: (INT g = pgcd(num OF f, den OF f); (num OF f % g, den OF f % g));
   OP + = (FRAC a, b) FRAC: NORM FRAC (num OF a * den OF b + num OF b * den OF a, den OF a * den OF b);
   OP * = (FRAC a, b) FRAC: NORM FRAC (num OF a * num OF b, den OF a * den OF b);
   PROC show = (FRAC f) STRING: whole(num OF f, 0) + "/" + whole(den OF f, 0);
   FRAC h = (1, 2), t = (1, 3);
   print((show(h + t), " ", show(h * t), newline));
   INT i := 10;
   i +:= 5; i -:= 3; i *:= 2; i %:= 5;
   print((i, newline));
   i PLUSAB 6; i MODAB 4;
   print((i, newline));
   REAL rr := 1;
   rr /:= 4; rr +:= 1;
   print((rr, newline));
   STRING s := "b";
   s +:= "c"; "a" +=: s; s *:= 2;
   print((s, newline));
   print((3 EQ 3, 3 NE 3, 2 LT 3, 2 GE 3, 7 OVER 2, 7 MOD 2, newline));
   print((ABS -3, SIGN -2.5, ODD 4, newline));
   INT j, k;
   j := k := 7;
   print((j + k, newline));
   (j > 3 | j | k) := 0;
   print((j, k, newline));
   print((- 2 ** 2, 2 ** 3 ** 2, newline))
END
