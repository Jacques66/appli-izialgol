# Jumps: GOTO, GO TO, label alone, EXIT, leaving a procedure and a recursion, label used as PROC VOID #
BEGIN
   INT i := 0;
   BEGIN
   start: i +:= 1;
      IF i < 3 THEN GOTO start FI;
      print((i, newline));
      GO TO next;
      print("never");
   next: print(("next", newline))
   END;
   BEGIN
      PROC search = (INT x) VOID: (x > 5 | found | print(("small ", whole(x, 0), newline)));
      search(2);
      search(9);
      print("never");
   found: print(("found", newline))
   END;
   INT v = (TRUE | 10 EXIT one: 20);
   print((v, newline));
   BEGIN
      PROC call = (PROC VOID p) VOID: (print(("before", newline)); p; print("never"));
      call(escape);
      print("never");
   escape: print(("escaped", newline))
   END;
   BEGIN
      INT depth := 0;
      PROC descend = (INT n) VOID: (depth := n; (n = 50 | finished); descend(n + 1));
      descend(1);
   finished: print((depth, newline))
   END
END
