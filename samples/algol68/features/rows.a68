# Rangees : tranches, trimmers, @, FLEX, LWB/UPB, affichages, rangees de rangees, selection multiple #
BEGIN
   [1:10] INT a;
   FOR i TO 10 DO a[i] := i OD;
   [] INT b = a[3:6];
   print((LWB b, UPB b, b[1], b[4], newline));
   [] INT c = a[3:6 @ 0];
   print((LWB c, UPB c, c[0], newline));
   [] INT d = a[@5];
   print((LWB d, UPB d, d[5], newline));
   a[2:4] := (20, 30, 40);
   print((a[1:5], newline));
   a[5:9] := a[4:8];
   print((a, newline));
   FLEX [1:0] INT f;
   print((UPB f, newline));
   f := (1, 2, 3);
   print((UPB f, newline));
   f := f[2:3];
   print((f, LWB f, UPB f, newline));
   [,] INT m = ((1, 2, 3), (4, 5, 6));
   print((1 UPB m, 2 UPB m, m[2, 3], newline));
   print((m[, 2], newline));
   [,] INT t = m[1:2, 2:3];
   print((t, newline));
   [3] [2] INT rr;
   FOR i TO 3 DO rr[i] := (i, i * 10) OD;
   print((rr[2][2], rr[3], newline));
   [] STRING mots = ("un", "deux", "trois");
   FOR i TO UPB mots DO print((mots[i], " ")) OD; print(newline);
   print((UPB mots[3], newline));
   [] INT vide = ();
   print((UPB vide, LWB vide, ELEMS vide, newline));
   MODE PT = STRUCT (INT x, y);
   [] PT pts = ((1, 2), (3, 4), (5, 6));
   print((x OF pts, newline));
   [3] PT vpts := pts;
   y OF vpts := (7, 8, 9);
   print((y OF vpts[2], newline));
   STRING s := "bonjour";
   s[1] := "B";
   print((s, " ", s[4:7], " ", UPB s, newline));
   s := s + " !";
   print((s, newline));
   [0:2, -1:1] REAL grille;
   FOR i FROM 0 TO 2 DO FOR j FROM -1 TO 1 DO grille[i, j] := i + j / 10 OD OD;
   print((fixed(grille[2, -1], 0, 1), " ", 1 LWB grille, " ", 2 LWB grille, newline))
END
