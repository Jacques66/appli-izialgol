# Transient names (RR 2.1.3.6.c): allowed uses of slices of FLEX names #
BEGIN
   STRING s := "abcdef";
   s[2] := "B";                         # destination: allowed #
   s[3:4] := "CD";                      # destination of a trim: allowed #
   CHAR c = s[5];                       # dereferenced: allowed #
   [] CHAR t = s[1:3];                  # value of the slice: allowed #
   print((s, " ", c, " ", t, " ", UPB s[2:4], newline))
END
