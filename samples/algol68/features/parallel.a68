# Parallel clause and semaphores: producer / consumer with a bounded buffer #
BEGIN
   INT size = 3;
   [0:size - 1] INT buffer;
   INT in := 0, out := 0;
   SEMA free = LEVEL size, full = LEVEL 0, mutex = LEVEL 1;
   INT n = 20;
   [1:n] INT received;
   PROC produce = VOID:
      FOR i TO n DO
         DOWN free; DOWN mutex;
         buffer[in] := i * i; in := (in + 1) MOD size;
         UP mutex; UP full
      OD;
   PROC consume = VOID:
      FOR i TO n DO
         DOWN full; DOWN mutex;
         received[i] := buffer[out]; out := (out + 1) MOD size;
         UP mutex; UP free
      OD;
   PAR (produce, consume);
   INT sum := 0;
   FOR i TO n DO sum +:= received[i] OD;
   print((sum, newline));
   BOOL in order := TRUE;
   FOR i TO n DO in order := in order AND received[i] = i * i OD;
   print((in order, LEVEL free, LEVEL full, newline));
   INT counter := 0;
   SEMA lock = LEVEL 1;
   PROC increment = VOID: TO 1000 DO DOWN lock; counter +:= 1; UP lock OD;
   PAR BEGIN increment, increment, increment END;
   print((counter, newline))
END
