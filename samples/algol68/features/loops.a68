# Loops: FOR FROM BY TO DOWNTO WHILE DO OD, UNTIL (a68g), bare loops #
BEGIN
   INT n := 0, k := 1, total := 0;
   FOR i FROM 1 TO 3 DO print(whole(i, 0)) OD; print(newline);
   FOR i FROM 10 BY -3 TO 1 DO print((whole(i, 0), " ")) OD; print(newline);
   FOR i FROM 5 DOWNTO 2 DO print(whole(i, 0)) OD; print(newline);
   FOR i BY 2 TO 9 DO print(whole(i, 0)) OD; print(newline);
   TO 4 DO n +:= 1 OD; print((n, newline));
   FOR i WHILE i * i < 30 DO print(whole(i, 0)) OD; print(newline);
   WHILE k < 100 DO k *:= 3 OD; print((k, newline));
   FOR i FROM 3 TO 1 DO print("never") OD;
   FOR i TO 3 DO FOR j FROM i TO 3 DO total +:= i * j OD OD;
   print((total, newline));
   k := 0;
   DO k +:= 2 UNTIL k > 5 OD; print((k, newline));
   FOR i TO 3 DO k := i UNTIL i = 2 OD; print((k, newline));
   k := 0;
   WHILE INT square = k * k; square < 50 DO k +:= 1 OD;
   print((k, newline));
   k := 0;
   DO k +:= 1; IF k = 7 THEN GOTO done FI OD;
done:
   print((k, newline))
END
