# Mode declarations: structural equivalence, recursive modes, actual bounds #
BEGIN
   MODE POINT = STRUCT (REAL x, y);
   MODE VECTOR = STRUCT (REAL x, y);           # same structure: equivalent modes #
   POINT p := (1.5, 2.5);
   VECTOR v := p;
   print((x OF v, y OF v, newline));

   MODE TREE = STRUCT (INT value, REF TREE left, right);
   PROC insert = (REF REF TREE a, INT x) VOID:
      IF REF TREE (a) IS NIL THEN a := HEAP TREE := (x, NIL, NIL)
      ELIF x < value OF a THEN insert(left OF a, x)
      ELSE insert(right OF a, x)
      FI;
   PROC walk = (REF TREE a) VOID:
      IF a ISNT NIL THEN walk(left OF a); print(whole(value OF a, -3)); walk(right OF a) FI;
   REF TREE root := NIL;
   FOR i TO 8 DO insert(root, (i * 37) MOD 23) OD;
   walk(root); print(newline);

   # mutual recursion between indicants #
   MODE LIST = REF CELL, CELL = STRUCT (INT head, LIST tail);
   LIST l := NIL;
   FOR i TO 4 DO l := HEAP CELL := (i * i, l) OD;
   INT sum := 0;
   WHILE l ISNT LIST (NIL) DO sum +:= head OF l; l := tail OF l OD;
   print(("sum of squares: ", whole(sum, 0), newline));

   # actual bounds in a mode declaration #
   INT n = 3;
   MODE VEC = [1:n] REAL;
   VEC a := (1, 2, 3);
   VEC b;
   b := a;
   b[2] := 20;
   print((UPB a, a[2], b[2], newline));

   # unions: order does not matter, flattening #
   MODE U1 = UNION (INT, REAL), U2 = UNION (REAL, INT);
   U1 x := 3;
   U2 y := x;
   UNION (CHAR, U1) w := "c";
   print(((y | (INT i): i | -1), (w | (CHAR c): c | "?"), newline));
   w := 2.5;
   CASE w IN (REAL r): print(r), (INT i): print(i) OUT print("other") ESAC;
   print(newline);
   # PROC modes and procedure variables #
   MODE FUNCTION = PROC (REAL) REAL;
   FUNCTION square = (REAL t) REAL: t * t;
   [] FUNCTION table = (square, (REAL t) REAL: t + 1, sqrt);
   FOR i TO UPB table DO print(fixed(table[i](4), 0, 1)); print(" ") OD;
   print(newline)
END
