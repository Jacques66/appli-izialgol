# Coercions: deproceduring, dereferencing, widening, rowing, uniting, voiding, balancing #
BEGIN
   INT counter := 0;
   PROC next = INT: counter +:= 1;
   INT a = next; INT b = next;              # deproceduring #
   print((a, b, newline));
   REF INT r = counter;
   INT c = r;                                     # dereferencing #
   print((c + 1, newline));
   REF REF INT rr = LOC REF INT := r;
   INT d = rr;                                    # double dereferencing #
   print((d, newline));
   REAL x = 2;                                    # widening INT -> REAL #
   COMPL z = x;                                   # widening REAL -> COMPL #
   LONG REAL lx = LENG 1.5;
   [] BOOL bits = 2r101;                          # widening BITS -> [] BOOL #
   print((x, newline));
   print((z, newline));
   print((lx, newline));
   print((UPB bits, bits[UPB bits], bits[UPB bits - 1], bits[UPB bits - 2], newline));
   [] INT one = 7;                                 # rowing #
   print((LWB one, UPB one, one[1], newline));
   [,] INT matrix = one;
   print((1 UPB matrix, 2 UPB matrix, matrix[1, 1], newline));
   STRING s = "x";
   print((UPB s, newline));
   UNION (INT, BOOL) u = TRUE;                    # uniting #
   print(((u | (BOOL bb): bb | FALSE), newline));
   counter;                                      # voiding #
   next;                                       # deproceduring, then voiding #
   print((counter, newline));
   PROC mean = ([] REAL t) REAL:
      (REAL sum := 0; FOR i FROM LWB t TO UPB t DO sum +:= t[i] OD; sum / (UPB t - LWB t + 1));
   print((mean((1, 2, 3, 4)), newline));
   print((IF a < b THEN 1 ELSE 2.5 FI, newline)); # strong context: each branch is united separately #
   print(((a < b | 1 | 2.5) * 2, newline));       # firm context: balancing to REAL #
   REAL q := (a > b | 1 | 0.5);
   print((q, newline));
   print((REAL (1) / 3, newline));                # cast #
   REF INT rc = counter;
   rc := 10;
   print((counter, newline))
END
