'COMMENT' Program written with QUOTE stropping (detected automatically) 'COMMENT'
'BEGIN'
   'INT' sum := 0;
   'FOR' i 'TO' 10 'DO' sum +:= i 'OD';
   'PROC' square = ('REAL' x) 'REAL': x * x;
   print((sum, newline));
   print((square(1.5), newline));
   'IF' sum > 50 'THEN' print(("large", newline)) 'ELSE' print(("small", newline)) 'FI';
   'STRING' Word := "Quote";
   print((word, newline)) # identifiers are not case sensitive #
'END'
