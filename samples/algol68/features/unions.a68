# Unions and conformity clauses #
BEGIN
   MODE NUMBER = UNION (INT, REAL, COMPL);
   PROC describe = (NUMBER n) STRING:
      CASE n IN
         (INT i): "integer " + whole(i, 0),
         (REAL r): "real " + fixed(r, 0, 2),
         (COMPL z): "complex " + fixed(re OF z, 0, 1) + "+" + fixed(im OF z, 0, 1) + "i"
      ESAC;
   [] NUMBER values = (1, 2.5, 3 I 4, -7);
   FOR k TO UPB values DO print((describe(values[k]), newline)) OD;
   MODE SCALAR = UNION (INT, REAL), ANY = UNION (SCALAR, STRING, BOOL);
   [] ANY various = (42, "text", TRUE, 1.5);
   FOR k TO UPB various DO
      CASE various[k] IN
         (SCALAR s): print(("scalar ", (s | (INT i): whole(i, 0) | "real"))),
         (STRING t): print(("string ", t)),
         (BOOL b): print(("boolean ", b))
      ESAC;
      print(newline)
   OD;
   UNION (INT, CHAR, VOID) u := EMPTY;
   CASE u IN (INT): print("int") OUSE u IN (CHAR c): print(c) OUT print("empty") ESAC;
   print(newline);
   u := "x";
   print(((u | (VOID): "nothing", (INT i): "integer" | "char"), newline));
   UNION (INT, STRING) w := "abc";
   print(((w | (STRING s): UPB s, (INT i): i), newline));
   w := 3;
   print(((w | (STRING s): UPB s, (INT i): i), newline));
   [] UNION (INT, STRING) list = (1, "two", 3);
   INT n := 0;
   FOR k TO UPB list DO (list[k] | (INT i): n +:= i) OD;
   print((n, newline))
END
