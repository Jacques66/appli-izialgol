# Choice clauses: IF ELIF ELSE, CASE IN OUSE OUT, brief forms, collaterals, ANDF ORF, ASSERT #
BEGIN
   PROC classify = (INT n) STRING:
      IF n < 0 THEN "negative" ELIF n = 0 THEN "zero" ELIF n < 10 THEN "small" ELSE "large" FI;
   FOR i FROM -1 BY 6 TO 11 DO print((classify(i), " ")) OD; print(newline);
   print((classify(0), newline));
   PROC day = (INT j) STRING:
      CASE j IN "monday", "tuesday", "wednesday" OUSE j - 3 IN "thursday", "friday" OUT "weekend" ESAC;
   FOR j TO 7 DO print((day(j), " ")) OD; print(newline);
   INT x = 7;
   print(((x > 5 | "yes" | "no"), (x | "one", "two" | "many"), (x < 0 | "a" |: x < 10 | "b" | "c"), newline));
   print(((2 | 10, 20, 30), newline));
   IF INT square = x * x; square > 40 THEN print(("square ", whole(square, 0), newline)) FI;
   INT y = (INT a := 3, b := 4; a * b);
   print((y, newline));
   INT p := 0, q := 0;
   (p := 1, q := 2);
   print((p + q, newline));
   [3] INT t := (1, 2, 3);
   INT k := 4;
   print((k <= 3 ANDF t[k] = 3, k > 3 ORF t[k] = 0, newline));
   ASSERT (x = 7);
   print(("end", newline))
END
