# Reading standard input: integers, rows, strings, reals, booleans, characters, end of file #
BEGIN
   INT n; read(n);
   [n] INT v; read(v);
   INT s := 0; FOR i TO n DO s +:= v[i] OD;
   print(("sum: ", whole(s, 0), newline));
   STRING name; read((newline, name, newline));
   print(("name: ", name, newline));
   REAL r; BOOL b; read((r, b));
   print((r * 2, b, newline));
   CHAR c; read(c);
   print(("char: ", c, newline));
   on logical file end(stand in, (REF FILE f) BOOL: (print(("end", newline)); GOTO finished));
   INT more; read(more);
   print("never");
finished:
   print(("finished", newline))
END
