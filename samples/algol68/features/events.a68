# Advanced transput: binary, reset, set, events (line end, value error, char error, format end), stand error #
BEGIN
   FILE f;
   establish(f, "data.bin", stand back channel);
   [] INT values = (3, 1, 4, 1, 5);
   put bin(f, (values, 2.5, TRUE, "end", 3 I 4));
   close(f);
   open(f, "data.bin", stand back channel);
   [5] INT reread; REAL x; BOOL b; STRING s; COMPL z;
   get bin(f, (reread, x, b, s, z));
   print((reread, x, b, " ", s, " ", RE z + IM z, newline));
   close(f);
   FILE t;
   establish(t, "text.txt", stand back channel);
   put(t, ("alpha", newline, "beta", newline, "gamma"));
   close(t);
   open(t, "text.txt", stand back channel);
   STRING word;
   get(t, (word, newline));
   get(t, word);
   print((word, " ", line number(t), newline));
   reset(t);
   get(t, word);
   print((word, newline));
   set(t, 1, 3, 2);
   get(t, word);
   print((word, newline));
   close(t);
   # line end event: reading an integer that crosses a line end #
   FILE e; STRING source := "12" + REPR 10 + "34";
   associate(e, source);
   INT ends := 0;
   on line end(e, (REF FILE ff) BOOL: (ends +:= 1; FALSE));
   INT a, c;
   get(e, (a, c));
   print((a, c, ends, newline));
   # mended value error #
   FILE v; STRING bad := "abc 7";
   associate(v, bad);
   BOOL seen := FALSE;
   on value error(v, (REF FILE ff) BOOL: (seen := TRUE; TRUE));
   INT k := -1;
   get(v, k);
   print((seen, k, newline));
   # character error in formatted input, suggestion accepted #
   FILE w; STRING data := "x=5;y=6";
   associate(w, data);
   on char error(w, (REF FILE ff, REF CHAR ch) BOOL: (print(("expected ", ch, newline)); TRUE));
   INT p, q;
   getf(w, ($"x="d","$, p));
   getf(w, ($"y="d$, q));
   print((p + q, newline));
   # format end: the format is restarted #
   FILE o; STRING output := "";
   associate(o, output);
   INT rounds := 0;
   on format end(o, (REF FILE ff) BOOL: (rounds +:= 1; FALSE));
   putf(o, ($d","$, 1, 2, 3));
   print((output, " ", rounds, newline));
   put(stand error, ("to stand error", newline));
   print((char number(stand out), newline))
END
