# Knuth's "man or boy" test: closures and recursion; the result must be -67 #
BEGIN
   PROC a = (INT k, PROC INT x1, x2, x3, x4, x5) INT:
   BEGIN
      INT kk := k;
      PROC b = INT: (kk -:= 1; a(kk, b, x1, x2, x3, x4));
      IF kk <= 0 THEN x4 + x5 ELSE b FI
   END;
   print((a(10, INT: 1, INT: -1, INT: -1, INT: 1, INT: 0), newline))
END
