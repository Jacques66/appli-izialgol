# Matrix product with [,] REAL, transpose, operators on rows #
BEGIN
   PRIO X = 7;
   OP X = ([,] REAL a, b) [,] REAL:
   BEGIN
      [1 UPB a, 2 UPB b] REAL c;
      FOR i TO 1 UPB a DO
         FOR j TO 2 UPB b DO
            REAL s := 0;
            FOR k TO 2 UPB a DO s +:= a[i, k] * b[k, j] OD;
            c[i, j] := s
         OD
      OD;
      c
   END;
   OP T = ([,] REAL a) [,] REAL:
   BEGIN
      [2 UPB a, 1 UPB a] REAL t;
      FOR i TO 1 UPB a DO FOR j TO 2 UPB a DO t[j, i] := a[i, j] OD OD;
      t
   END;
   PROC display = ([,] REAL m) VOID:
      FOR i TO 1 UPB m DO
         FOR j TO 2 UPB m DO printf(($-2zd.d$, m[i, j])) OD;
         print(newline)
      OD;
   [,] REAL a = ((1, 2, 3), (4, 5, 6));
   [,] REAL b = ((7, 8), (9, 10), (11, 12));
   display(a X b);
   print(newline);
   display(T a);
   print(newline);
   display(T a X T T a)
END
