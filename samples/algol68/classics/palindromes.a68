# Palindromes: string processing, boolean procedures #
BEGIN
   PROC clean = (STRING s) STRING:
   BEGIN
      STRING r := "";
      FOR i FROM LWB s TO UPB s DO
         CHAR c = to lower(s[i]);
         IF is alpha(c) THEN r +:= c FI
      OD;
      r
   END;
   PROC palindrome = (STRING s) BOOL:
   BEGIN
      STRING t = clean(s);
      BOOL ok := TRUE;
      FOR i TO UPB t % 2 WHILE ok DO ok := t[i] = t[UPB t - i + 1] OD;
      ok
   END;
   [] STRING tries = ("kayak", "Algol", "A man, a plan, a canal: Panama", "Was it a car or a cat I saw", "abc");
   FOR k TO UPB tries DO
      print((tries[k], ": ", (palindrome(tries[k]) | "yes" | "no"), newline))
   OD
END
