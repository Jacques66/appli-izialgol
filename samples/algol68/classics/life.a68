# Jeu de la vie de Conway : oscillateur "clignotant" sur une grille torique 5 x 5 #
BEGIN
   INT n = 5;
   MODE GRILLE = [0:n - 1, 0:n - 1] BOOL;
   GRILLE g;
   FOR i FROM 0 TO n - 1 DO FOR j FROM 0 TO n - 1 DO g[i, j] := FALSE OD OD;
   g[1, 2] := g[2, 2] := g[3, 2] := TRUE;
   PROC voisins = (GRILLE h, INT i, j) INT:
   BEGIN
      INT c := 0;
      FOR di FROM -1 TO 1 DO
         FOR dj FROM -1 TO 1 DO
            IF NOT (di = 0 AND dj = 0) ANDF h[(i + di) MOD n, (j + dj) MOD n] THEN c +:= 1 FI
         OD
      OD;
      c
   END;
   PROC afficher = (GRILLE h, INT gen) VOID:
   BEGIN
      print(("generation ", whole(gen, 0), newline));
      FOR i FROM 0 TO n - 1 DO
         FOR j FROM 0 TO n - 1 DO print((h[i, j] | "#" | ".")) OD;
         print(newline)
      OD
   END;
   FOR gen FROM 0 TO 2 DO
      afficher(g, gen);
      GRILLE s;
      FOR i FROM 0 TO n - 1 DO
         FOR j FROM 0 TO n - 1 DO
            INT v = voisins(g, i, j);
            s[i, j] := (g[i, j] | v = 2 OR v = 3 | v = 3)
         OD
      OD;
      g := s
   OD
END
