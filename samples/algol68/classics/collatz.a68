# Collatz sequence: number of steps and maximum reached #
BEGIN
   PROC collatz = (INT start, REF INT maximum) INT:
   BEGIN
      INT n := start, steps := 0;
      maximum := n;
      WHILE n /= 1 DO
         n := (ODD n | 3 * n + 1 | n % 2);
         IF n > maximum THEN maximum := n FI;
         steps +:= 1
      OD;
      steps
   END;
   INT m;
   INT e = collatz(27, m);
   print(("27: ", whole(e, 0), " steps, maximum ", whole(m, 0), newline));
   INT best := 1, record := 0;
   FOR i TO 30 DO
      INT k = collatz(i, LOC INT);
      IF k > record THEN record := k; best := i FI
   OD;
   print(("longest sequence for i <= 30: ", whole(best, 0), " (", whole(record, 0), " steps)", newline))
END
