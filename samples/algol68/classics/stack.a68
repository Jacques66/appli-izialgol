# Generic stack: union, recursive structure, HEAP, procedures on names #
BEGIN
   MODE ITEM = UNION (INT, STRING);
   MODE CELL = STRUCT (ITEM val, REF CELL below);
   MODE STACK = REF CELL;
   PROC push = (REF STACK p, ITEM e) VOID: p := HEAP CELL := (e, p);
   PROC pop = (REF STACK p) ITEM:
      IF STACK (p) IS NIL THEN print(("empty stack", newline)); SKIP
      ELSE ITEM e = val OF p; p := below OF p; e
      FI;
   PROC empty = (STACK p) BOOL: p IS NIL;
   STACK p := NIL;
   push(p, 1); push(p, "two"); push(p, 3);
   WHILE NOT empty(p) DO
      CASE pop(p) IN
         (INT i): print(("integer ", whole(i, 0), newline)),
         (STRING s): print(("string ", s, newline))
      ESAC
   OD
END
