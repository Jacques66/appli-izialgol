# Palindromes : traitement de chaines, procedures booleennes #
BEGIN
   PROC nettoyer = (STRING s) STRING:
   BEGIN
      STRING r := "";
      FOR i FROM LWB s TO UPB s DO
         CHAR c = to lower(s[i]);
         IF is alpha(c) THEN r +:= c FI
      OD;
      r
   END;
   PROC palindrome = (STRING s) BOOL:
   BEGIN
      STRING t = nettoyer(s);
      BOOL ok := TRUE;
      FOR i TO UPB t % 2 WHILE ok DO ok := t[i] = t[UPB t - i + 1] OD;
      ok
   END;
   [] STRING essais = ("kayak", "Algol", "Esope reste ici et se repose", "Engage le jeu que je le gagne", "abc");
   FOR k TO UPB essais DO
      print((essais[k], " : ", (palindrome(essais[k]) | "oui" | "non"), newline))
   OD
END
