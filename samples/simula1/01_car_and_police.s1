comment The car and police model, after the example used by Dahl and Nygaard to
        present Simula I: cars move along a road, a police process looks at
        every car on the road at regular intervals and slows down the speeders.
        A car is an activity, the road is a set, and the police reaches the
        local quantities of a car with inspect;
SIMULA begin
   activity car(number, speed); integer number; real speed;
   begin real X0, T0, V;
      real procedure X; X := X0 + V × (time - T0);
      procedure newV(Vnew); real Vnew;
      begin X0 := X; T0 := time; V := Vnew end;
      V := speed; T0 := time;
      include(current, road);
      outstring(1, "time "); outreal(1, time); outstring(1, "car "); outinteger(1, number);
      outstring(1, "enters at speed "); outreal(1, V); outstring(1, "\n");
      hold(10);
      remove(find(current, road));
      outstring(1, "time "); outreal(1, time); outstring(1, "car "); outinteger(1, number);
      outstring(1, "leaves at x = "); outreal(1, X); outstring(1, "\n")
   end of car;

   activity police(limit); real limit;
   begin element C;
      while true do
      begin
         hold(2);
         C := head(road);
         for C := suc(C) while exist(C) do
            inspect C when car do
               if V > limit then
               begin
                  outstring(1, "time "); outreal(1, time);
                  outstring(1, "fine for car "); outinteger(1, number);
                  outstring(1, "at speed "); outreal(1, V); outstring(1, "\n");
                  newV(limit)
               end
      end
   end of police;

   comment the element of the set S that refers to the same process as P;
   element procedure find(P, S); element P; set S;
   begin element E;
      E := head(S);
      for E := suc(E) while exist(E) do
         if E = P then begin find := E; goto done end;
   done:
   end find;

   set road;
   integer i;
   for i := 1 step 1 until 4 do activate new car(i, 40 + 10 × i) delay i;
   activate new police(50);
   hold(30);
   outstring(1, "cars still on the road: "); outinteger(1, cardinal(road)); outstring(1, "\n")
end of simulation model
