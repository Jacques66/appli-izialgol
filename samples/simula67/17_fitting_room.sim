! The classic SIMULATION example of the Simula literature (also shown in the
  Wikipedia article on Simula): Sam, Sally and Andy are shopping for clothes
  and share one fitting room. Each of them browses for about 12 minutes
  (normally distributed), asks for the fitting room, waits in a queue if it
  is in use, tries clothes on for about 3 minutes and leaves.
  Shows: Process subclasses, Hold, Wait, Activate, a Head used as a queue. ;
Simulation Begin
   Class FittingRoom; Begin
      Ref (Head) door;
      Boolean inUse;
      Procedure request; Begin
         If inUse Then Begin
            Wait (door);
            door.First.Out;
         End;
         inUse := True;
      End;
      Procedure leave; Begin
         inUse := False;
         Activate door.First;
      End;
      door :- New Head;
   End;

   Procedure report (message); Text message; Begin
      OutFix (Time, 2, 6); OutText (": " & message); OutImage;
   End;

   Process Class Person (pname); Text pname; Begin
      While True Do Begin
         Hold (Normal (12, 4, u));
         report (pname & " is requesting the fitting room");
         fittingRoom1.request;
         report (pname & " has entered the fitting room");
         Hold (Normal (3, 1, u));
         fittingRoom1.leave;
         report (pname & " has left the fitting room");
      End;
   End;

   Integer u;
   Ref (FittingRoom) fittingRoom1;

   u := 13;
   fittingRoom1 :- New FittingRoom;
   Activate New Person ("Sam");
   Activate New Person ("Sally");
   Activate New Person ("Andy");
   Hold (100);
End;
