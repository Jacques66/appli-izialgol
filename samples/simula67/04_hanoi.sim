! Towers of Hanoi ;
begin
   integer moves;
   procedure move(n, source, target, spare); integer n; character source, target, spare;
      if n > 0 then
      begin
         move(n - 1, source, spare, target);
         moves := moves + 1;
         outtext("disk "); outint(n, 0); outtext(": "); outchar(source); outtext(" -> "); outchar(target); outimage;
         move(n - 1, spare, target, source)
      end;
   move(4, 'A', 'C', 'B');
   outint(moves, 0); outtext(" moves"); outimage
end
