comment Towers of Hanoi, a recursive procedure with value parameters;
begin
   integer moves;

   procedure hanoi(n, from, dest, via); value n, from, dest, via; integer n, from, dest, via;
      if n > 0 then
      begin
         hanoi(n - 1, from, via, dest);
         moves := moves + 1;
         outstring(1, "move disk "); outinteger(1, n);
         outstring(1, "from "); outinteger(1, from);
         outstring(1, "to "); outinteger(1, dest); outstring(1, "\n");
         hanoi(n - 1, via, dest, from)
      end hanoi;

   moves := 0;
   hanoi(3, 1, 3, 2);
   outstring(1, "total: "); outinteger(1, moves); outstring(1, "moves\n")
end
