! Ecriture puis relecture d'un fichier texte ;
begin
   ref(outfile) sortie; ref(infile) entree;
   integer i;
   sortie :- new outfile("table_carres.txt");
   sortie.open(blanks(40));
   for i := 1 step 1 until 10 do
   begin sortie.outint(i, 4); sortie.outint(i * i, 6); sortie.outimage end;
   sortie.close;
   entree :- new infile("table_carres.txt");
   entree.open(blanks(40));
   inspect entree do
   begin
      inimage;
      while not endfile do
      begin
         outtext("lu : "); outtext(image.strip); outimage;
         inimage
      end;
      close
   end
end
