! Simulation d'une banque avec la classe standard SIMULATION ;
! Arrivees aleatoires (loi exponentielle), service uniforme. ;
simulation begin
   ref(head) file_attente;
   integer graine_arrivee, graine_service, servis;
   real attente_totale, duree;

   process class client;
   begin real arrivee;
      arrivee := time;
      into(file_attente);
      if guichetier.idle then activate guichetier;
      passivate;
      attente_totale := attente_totale + (time - arrivee);
      servis := servis + 1
   end;

   process class guichetier_c;
   begin ref(client) c;
      while true do
      begin
         while not file_attente.empty do
         begin
            c :- file_attente.first;
            c.out;
            hold(uniform(1.0, 5.0, graine_service));
            activate c
         end;
         passivate
      end
   end;

   process class generateur;
   begin
      while time < duree do
      begin
         activate new client;
         hold(negexp(0.25, graine_arrivee))
      end
   end;

   ref(guichetier_c) guichetier;
   graine_arrivee := 12345; graine_service := 54321;
   duree := 480;
   file_attente :- new head;
   guichetier :- new guichetier_c;
   activate new generateur;
   hold(600);
   outtext("Clients servis      : "); outint(servis, 0); outimage;
   outtext("Attente moyenne     : "); outfix(attente_totale / servis, 2, 0); outtext(" minutes"); outimage;
   outtext("Clients en attente  : "); outint(file_attente.cardinal, 0); outimage
end
