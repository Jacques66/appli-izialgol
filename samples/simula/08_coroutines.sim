! Coroutines: a producer and a consumer hand control to each other (resume) ;
begin
   ref(producer) prod; ref(consumer) cons;
   integer buffer;

   class producer;
   begin integer i;
      detach;
      for i := 1 step 1 until 5 do
      begin
         buffer := i * i;
         outtext("produced "); outint(buffer, 3); outimage;
         resume(cons)
      end
   end;

   class consumer;
   begin integer total;
      detach;
      while true do
      begin
         total := total + buffer;
         outtext("consumed "); outint(buffer, 3); outtext("   total "); outint(total, 3); outimage;
         resume(prod)
      end
   end;

   prod :- new producer;
   cons :- new consumer;
   resume(prod);
   outtext("production finished"); outimage
end
