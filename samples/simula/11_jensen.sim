! Appel par nom : le procede de Jensen ;
begin
   integer i;
   real array a(1:5);
   real procedure somme(k, bas, haut, terme); name k, terme; integer k, bas, haut; real terme;
   begin real s;
      k := bas;
      while k <= haut do begin s := s + terme; k := k + 1 end;
      somme := s
   end;
   for i := 1 step 1 until 5 do a(i) := i * 1.5;
   outtext("somme des a(i)       = "); outfix(somme(i, 1, 5, a(i)), 2, 0); outimage;
   outtext("somme des i**2       = "); outfix(somme(i, 1, 10, i ** 2), 0, 0); outimage;
   outtext("somme des 1/i        = "); outfix(somme(i, 1, 100, 1 / i), 6, 0); outimage
end
