! Call by name: Jensen's device ;
begin
   integer i;
   real array a(1:5);
   real procedure sum(k, low, high, term); name k, term; integer k, low, high; real term;
   begin real s;
      k := low;
      while k <= high do begin s := s + term; k := k + 1 end;
      sum := s
   end;
   for i := 1 step 1 until 5 do a(i) := i * 1.5;
   outtext("sum of a(i)       = "); outfix(sum(i, 1, 5, a(i)), 2, 0); outimage;
   outtext("sum of i**2       = "); outfix(sum(i, 1, 10, i ** 2), 0, 0); outimage;
   outtext("sum of 1/i        = "); outfix(sum(i, 1, 100, 1 / i), 6, 0); outimage
end
