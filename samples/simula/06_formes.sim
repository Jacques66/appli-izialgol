! Classes, sous-classes, procedures virtuelles et inspect ;
begin
   class forme(nom); text nom;
   virtual: real procedure aire;
   begin
      procedure decris;
      begin
         outtext(nom); outtext(" : aire = "); outfix(aire, 2, 0); outimage
      end;
   end forme;

   forme class rectangle(l, h); real l, h;
   begin real procedure aire; aire := l * h; end;

   rectangle class carre;
   begin end;

   forme class cercle(r); real r;
   begin real procedure aire; aire := 3.14159265358979 * r * r; end;

   ref(forme) array formes(1:3);
   integer i; real total;
   formes(1) :- new rectangle("rectangle 3x4", 3, 4);
   formes(2) :- new carre("carre 5x5", 5, 5);
   formes(3) :- new cercle("cercle r=1", 1);
   for i := 1 step 1 until 3 do
   begin
      formes(i).decris;
      total := total + formes(i).aire
   end;
   outtext("aire totale : "); outfix(total, 2, 0); outimage;
   for i := 1 step 1 until 3 do
      inspect formes(i)
         when carre do begin outtext(nom); outtext(" est un carre"); outimage end
         when rectangle do begin outtext(nom); outtext(" est un rectangle de largeur "); outfix(l, 1, 0); outimage end
         otherwise begin outtext(formes(i).nom); outtext(" n'est pas un rectangle"); outimage end
end
