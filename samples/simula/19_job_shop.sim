! A job shop, after the example used by Dahl and Nygaard to present SIMULA
  ("SIMULA - an ALGOL-based simulation language", 1966): orders of three
  kinds travel through groups of identical machines in a prescribed order.
  Every machine group has a queue, and an order waits there until a machine
  of the group is free. The model reports the utilisation of every group,
  the waiting times and the throughput time of every kind of order.
  Shows: a resource class built on SIMSET queues, wait and activate after,
  two-dimensional arrays of routes, accum. ;
Simulation Begin
   Integer seed, seedKind, orderCount;
   Real simPeriod;

   Class MachineGroup (gname, size); Text gname; Integer size; Begin
      Integer free, served;
      Real busyArea, busyLast, busyCount, waitTotal;
      Ref (Head) queue;
      Procedure seize; Begin
         If free > 0 Then free := free - 1
         Else Wait (queue);      ! release hands a machine over to us ;
         Accum (busyArea, busyLast, busyCount, 1);
      End;
      Procedure release; Begin
         Ref (Process) next;
         Accum (busyArea, busyLast, busyCount, -1);
         served := served + 1;
         If queue.Empty Then free := free + 1
         Else Begin
            next :- queue.First;
            next.Out;
            Activate next After Current;
         End;
      End;
      free := size;
      queue :- New Head;
   End;

   Ref (MachineGroup) Array group (1:4);
   Integer Array routeLength (1:3), route (1:3, 1:4);
   Real Array opTime (1:3, 1:4);
   Integer Array finished (1:3);
   Real Array flowTime (1:3);

   Process Class Order (kind); Integer kind; Begin
      Integer stage; Real entry, waitStart;
      Ref (MachineGroup) g;
      entry := Time;
      For stage := 1 Step 1 Until routeLength (kind) Do Begin
         g :- group (route (kind, stage));
         waitStart := Time;
         g.seize;
         g.waitTotal := g.waitTotal + (Time - waitStart);
         Hold (opTime (kind, stage) * Uniform (0.8, 1.2, seed));
         g.release;
      End;
      finished (kind) := finished (kind) + 1;
      flowTime (kind) := flowTime (kind) + (Time - entry);
   End;

   Process Class OrderSource; Begin
      While Time < simPeriod Do Begin
         orderCount := orderCount + 1;
         Activate New Order (Randint (1, 3, seedKind));
         Hold (Negexp (1 / 4.0, seed));
      End;
   End;

   Procedure setRoute (kind, n, g1, t1, g2, t2, g3, t3, g4, t4);
      Integer kind, n, g1, g2, g3, g4; Real t1, t2, t3, t4;
   Begin
      routeLength (kind) := n;
      route (kind, 1) := g1; opTime (kind, 1) := t1;
      route (kind, 2) := g2; opTime (kind, 2) := t2;
      route (kind, 3) := g3; opTime (kind, 3) := t3;
      route (kind, 4) := g4; opTime (kind, 4) := t4;
   End;

   Integer i;
   seed := 4711; seedKind := 815; simPeriod := 40 * 60;
   group (1) :- New MachineGroup ("lathes", 3);
   group (2) :- New MachineGroup ("drills", 2);
   group (3) :- New MachineGroup ("mills", 2);
   group (4) :- New MachineGroup ("grinders", 1);
   !             kind  n  group time  group time  group time  group time ;
   setRoute (1, 3, 1, 8.0, 2, 5.0, 4, 2.0, 0, 0);
   setRoute (2, 4, 3, 6.0, 1, 7.0, 2, 4.0, 4, 1.5);
   setRoute (3, 2, 2, 3.0, 3, 9.0, 0, 0, 0, 0);
   Activate New OrderSource;
   Hold (simPeriod + 600);

   OutText ("Job shop: 40 hours of order arrivals, ");
   OutInt (orderCount, 0); OutText (" orders released"); OutImage;
   OutImage;
   OutText ("group       machines  served  utilisation  avg wait"); OutImage;
   For i := 1 Step 1 Until 4 Do Inspect group (i) Do Begin
      Accum (busyArea, busyLast, busyCount, 0);
      OutText (gname); SetPos (13); OutInt (size, 8); OutInt (served, 8);
      OutFix (100 * busyArea / (Time * size), 1, 12); OutText (" %");
      OutFix (If served > 0 Then waitTotal / served Else 0, 2, 9);
      OutImage;
   End;
   OutImage;
   OutText ("order kind  finished  avg throughput time (min)"); OutImage;
   For i := 1 Step 1 Until 3 Do Begin
      OutInt (i, 10); OutInt (finished (i), 10);
      OutFix (If finished (i) > 0 Then flowTime (i) / finished (i) Else 0, 2, 16);
      OutImage;
   End;
End;
