! Tours de Hanoi ;
begin
   integer coups;
   procedure deplace(n, depart, arrivee, inter); integer n; character depart, arrivee, inter;
      if n > 0 then
      begin
         deplace(n - 1, depart, inter, arrivee);
         coups := coups + 1;
         outtext("disque "); outint(n, 0); outtext(" : "); outchar(depart); outtext(" -> "); outchar(arrivee); outimage;
         deplace(n - 1, inter, arrivee, depart)
      end;
   deplace(4, 'A', 'C', 'B');
   outint(coups, 0); outtext(" deplacements"); outimage
end
