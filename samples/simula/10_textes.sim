! Traitement de textes : decoupage en mots, inversion, majuscules ;
begin
   text phrase, mot;
   integer nb;

   text procedure inverse(t); text t;
   begin text r; integer i;
      r :- blanks(t.length);
      for i := 1 step 1 until t.length do r.sub(t.length - i + 1, 1) := t.sub(i, 1);
      inverse :- r
   end;

   procedure mot_suivant;
   begin integer debut;
      while phrase.more and then phrase.sub(phrase.pos, 1) = " " do phrase.setpos(phrase.pos + 1);
      debut := phrase.pos;
      while phrase.more and then phrase.sub(phrase.pos, 1) <> " " do phrase.setpos(phrase.pos + 1);
      mot :- phrase.sub(debut, phrase.pos - debut)
   end;

   phrase :- copy("  Simula est le premier langage objet  ");
   outtext("Phrase : [" & phrase.strip & "]"); outimage;
   phrase.setpos(1);
   mot_suivant;
   while mot =/= notext do
   begin
      nb := nb + 1;
      outint(nb, 2); outtext(" : "); outtext(mot); outtext(" -> "); outtext(inverse(mot)); outimage;
      mot_suivant
   end;
   outtext("En majuscules : "); outtext(upcase(copy(phrase.strip))); outimage
end
